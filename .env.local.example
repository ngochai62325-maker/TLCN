# Copy to .env.local. Keep personal credentials out of Git.
# Relative to the repository; all 21 pinned files plus nso/metadata.txt are needed.
SILVER_TEST_RAW_ROOT=./data/raw
TLCN_SPARK_IMAGE=tlcn/silver-spark:local
TLCN_AIRFLOW_IMAGE=tlcn/silver-airflow:local
# Airflow demo port is fixed to 127.0.0.1:8085 in compose.local.yml.
TLCN_TRINO_PORT=18080
