MAPPING: source_to_gold_mapping.csv covers every column and source branch.
VALIDATION: README.md DQ gates; mandatory identities must not be collapsed to Unknown.
'''
}

// FACT: One country, commodity, attribute and marketing-year observation.
Table gold_local.fact_usda_psd_observation {
  observation_key varchar(64) [pk, note: 'SHA-256 K1 typed-array protocol; no increment/row_number; collision gate required.']
  geography_key varchar(64) [not null, ref: > gold_local.dim_source_geography.geography_key, note: 'G1 exact namespace/scope/source identity; exactly one match; mandatory identity never zero-hash fallback.']
