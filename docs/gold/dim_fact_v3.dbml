  _ingestion_batch_id varchar [not null, note: '_ingestion_batch_id; technical lineage column emitted by framework, not inferred from business labels.']
  _ingestion_chunk_id bigint [not null, note: '_ingestion_chunk_id; technical lineage column emitted by framework, not inferred from business labels.']
  _ingestion_timestamp timestamptz [not null, note: '_ingestion_timestamp; technical lineage column emitted by framework, not inferred from business labels.']
  _source_id varchar [not null, note: '_source_id; technical lineage column emitted by framework, not inferred from business labels.']
  _source_file varchar [not null, note: '_source_file; technical lineage column emitted by framework, not inferred from business labels.']
  _source_checksum varchar [not null, note: '_source_checksum; technical lineage column emitted by framework, not inferred from business labels.']
  _source_snapshot_id bigint [not null, note: 'Upstream lineage only; may be 0, never use as Silver read snapshot.']
  _silver_processed_at timestamptz [not null, note: '_silver_processed_at; upstream processing time, not publication/availability time.']
  dq_warnings_json varchar [not null, note: 'Deterministic JSON serialization of upstream warning array; [] for empty array, never drop warnings.']
  silver_table_uuid varchar [not null, note: 'Read actual Silver Iceberg table UUID from pinned input metadata; execution admission context, not a source column.']
  silver_read_snapshot_id bigint [not null, note: 'Actual Silver snapshot pinned before reading, required positive; not Bronze snapshot or _source_snapshot_id.']
  source_business_key_json varchar [not null, note: 'Exact ordered Silver business key; retained for collision and row-reconciliation gates.']
  source_context_json varchar [not null, note: 'Canonical deterministic JSON object of exactly [geography_raw,geography_name_candidate,geography_level,geography_status,geography_code,boundary_version,geography_mapping_version,geography_evidence,unit_raw,unit_source_reference,unit_status,unit_reference,unit_evidence,unit_mapping_version,metadata_version,value_raw]; preserve original NULL, strings and decimals; source flags/evidence are not overwritten.']
  gold_model_version varchar [not null, note: 'Literal gold-20261025.1. Attempt timestamp/UUID is not a content change.']

  indexes {
    (source_table, source_geography_key, year_key, measure, season, statistic_kind) [unique, name: 'uq_fact_nso_observation_grain']
  }

  Note: '''
GRAIN: One source_table, source_geography_key, year, measure, season and statistic_kind observation.
NATURAL/ANALYTICAL KEY: (source_table, source_geography_key, year_key, measure, season, statistic_kind).
INPUT DATASETS: nso. Physical prefix: iceberg.silver_local.
Keep every publication separately and all geographic/season/statistic scopes. No aggregation across levels, source_table, annual/season or quantity/index. Value is already normalized Silver value.
MAPPING: source_to_gold_mapping.csv covers every column and source branch.
VALIDATION: README.md DQ gates; mandatory identities must not be collapsed to Unknown.
'''
}
