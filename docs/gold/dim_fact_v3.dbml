// Canonical Gold schema: gold-20261025.1
// Design date: 2026-10-25 Asia/Bangkok; baseline main@1bb662c49cac2f82af14ce4b5c9a5d909c2a0e05
// Owner approved MVP for implementation on 2026-10-26. Target iceberg.gold_local.
// Semantic delivery: four version-controlled SQL query definitions, owner approved 2026-10-26.
// Input iceberg.silver_local (local_nine); see README.md for G1/P1/S1/U1/U2/A1/K1.
// Source-to-field mapping was prepared first in source_to_gold_mapping.csv.
// This file keeps its historical filename for stable references; the old 27-table v3 is superseded.
// Iceberg does not enforce these logical PK/FK/UNIQUE assertions. Validate before publishing.

Project rice_lakehouse_gold_20261025 {
  database_type: 'Apache Iceberg'
  Note: 'Owner approved gold-20261025.1: 8 dimensions and 9 facts. Semantic delivery uses four version-controlled read-only SQL queries over published snapshots, without catalog views. No crosswalk, aggregate or forecasting mart. Runtime acceptance is recorded in VALIDATION.md.'
}

// DIMENSION: One canonical local_nine dataset.
Table gold_local.dim_source_system {
  source_system_key varchar(64) [pk, note: 'SHA-256 K1 typed-array protocol; no increment/row_number; collision gate required.']
  source_id varchar [not null, note: 'Canonical dataset ID from local_profile.MAPPINGS and source_registry; fixed nine entries.']
  provider varchar [not null, note: 'Lookup provider in source_registry.yaml using exact source_id; configuration metadata.']
  dataset_label varchar [not null, note: 'Lookup dataset in source_registry.yaml; display only, never a join key.']

  indexes {
    (source_id) [unique, name: 'uq_dim_source_system_grain']
  }

  Note: '''
GRAIN: One canonical local_nine dataset.
NATURAL/ANALYTICAL KEY: (source_id).
INPUT DATASETS: faostat_monthly_price, faostat_production, faostat_supply_utilization, faostat_trade, nso, thitruongnongsan, usda_psd, usda_rice_yearbook, worldbank_pinksheet. Physical prefix: iceberg.silver_local.
Type 0 source identity; source_id is the verified nine-source whitelist, not every enabled registry entry.
MAPPING: source_to_gold_mapping.csv covers every column and source branch.
VALIDATION: README.md DQ gates; mandatory identities must not be collapsed to Unknown.
'''
}

// DIMENSION: One valid calendar year; excludes opaque USDA reference/marketing year labels.
Table gold_local.dim_year {
  year_key integer [pk, note: 'year; validate calendar domain before using as key.']
  decade integer [not null, note: '10 * floor(year / 10).']
  is_leap_year boolean [not null, note: 'year % 400 = 0 OR (year % 4 = 0 AND year % 100 <> 0).']

  Note: '''
GRAIN: One valid calendar year; excludes opaque USDA reference/marketing year labels.
NATURAL/ANALYTICAL KEY: (year_key).
INPUT DATASETS: faostat_monthly_price, faostat_production, faostat_supply_utilization, faostat_trade, nso, thitruongnongsan, worldbank_pinksheet. Physical prefix: iceberg.silver_local.
Calendar reference Type 0; no fake Unknown date/year row. Valid source years determine finite calendar spine.
MAPPING: source_to_gold_mapping.csv covers every column and source branch.
VALIDATION: README.md DQ gates; mandatory identities must not be collapsed to Unknown.
'''
}

// DIMENSION: One calendar month; dense between approved calendar endpoints.
Table gold_local.dim_month {
  month_key integer [pk, note: '100 * year + month; FAO only time_grain=monthly; enforce 1..12. | 100 * year(date) + month(date).']
  year_key integer [not null, ref: > gold_local.dim_year.year_key, note: 'Resolve dim_year by true calendar year; exactly one match.']
  month_number integer [not null, note: 'month; monthly rows only. | month(date).']
  quarter_number integer [not null, note: '1 + floor((calendar_month - 1) / 3).']
  month_start date [not null, note: 'Valid first day of calendar month; generate dense month spine without observations/imputation.']

  Note: '''
GRAIN: One calendar month; dense between approved calendar endpoints.
NATURAL/ANALYTICAL KEY: (month_key).
INPUT DATASETS: faostat_monthly_price, worldbank_pinksheet, thitruongnongsan. Physical prefix: iceberg.silver_local.
Calendar only. Annual code 7021 and USDA Yearbook labels never create month rows.
MAPPING: source_to_gold_mapping.csv covers every column and source branch.
VALIDATION: README.md DQ gates; mandatory identities must not be collapsed to Unknown.
'''
}

// DIMENSION: One valid calendar day.
Table gold_local.dim_date {
  date_key integer [pk, note: '10000 * year(date) + 100 * month(date) + day(date).']
  full_date date [not null, unique, note: 'date; unique, validate actual calendar date.']
  month_key integer [not null, ref: > gold_local.dim_month.month_key, note: 'dim_month by year(date), month(date); exactly one match.']
  iso_weekday integer [not null, note: 'ISO weekday: Monday=1 through Sunday=7.']
  day_of_month integer [not null, note: 'day(date).']

  Note: '''
GRAIN: One valid calendar day.
NATURAL/ANALYTICAL KEY: (date_key).
INPUT DATASETS: thitruongnongsan. Physical prefix: iceberg.silver_local.
Type 0 daily calendar, FK to month; no invalid date sentinel.
MAPPING: source_to_gold_mapping.csv covers every column and source branch.
VALIDATION: README.md DQ gates; mandatory identities must not be collapsed to Unknown.
'''
}

// DIMENSION: One source geography identity within explicit namespace and scope; no official administrative conformance.
Table gold_local.dim_source_geography {
  geography_key varchar(64) [pk, note: 'SHA-256 K1 typed-array protocol; no increment/row_number; collision gate required.']
  identity_namespace varchar [not null, note: 'G1 namespace: faostat_m49 / nso_raw_label / usda_psd_country / usda_yearbook_location / vn_market_label.']
  identity_scope varchar [not null, note: 'G1: FAO fixed faostat; NSO exact source_table; other sources exact canonical dataset ID.']
  source_identity varchar [not null, note: 'G1: each reporter/partner M49 code, country_code, NSO source_geography_key, PSD country, Yearbook location, or VN market; no additional case/alias normalization.']
  source_labels_json varchar [not null, note: 'Canonical sorted distinct source labels for this exact identity; NSO raw and candidate labelled separately; never choose an official name.']
  source_level varchar [not null, note: 'NSO geography_level unchanged lowercase; FAO source_area, VN market_label, USDA source_location; classification is not official administrative level.']
  interpretation_status varchar [not null, note: 'NSO geography_status; others source_identity_only. No approved boundary/country-membership claim.']

  indexes {
    (identity_namespace, identity_scope, source_identity) [unique, name: 'uq_dim_source_geography_grain']
  }

  Note: '''
GRAIN: One source geography identity within explicit namespace and scope; no official administrative conformance.
NATURAL/ANALYTICAL KEY: (identity_namespace, identity_scope, source_identity).
INPUT DATASETS: faostat_monthly_price, faostat_production, faostat_supply_utilization, faostat_trade, nso, thitruongnongsan, usda_psd, usda_rice_yearbook. Physical prefix: iceberg.silver_local.
Source identity Type 0; source labels/status Type 1 only. FAO M49 shared by exact code, NSO scope includes source_table; no SCD2/ISO/region hierarchy. Technical zero-hash member only for non-geographic WB benchmark.
MAPPING: source_to_gold_mapping.csv covers every column and source branch.
VALIDATION: README.md DQ gates; mandatory identities must not be collapsed to Unknown.
'''
}

// DIMENSION: One source product/class/benchmark identity within namespace.
Table gold_local.dim_source_product {
  product_key varchar(64) [pk, note: 'SHA-256 K1 typed-array protocol; no increment/row_number; collision gate required.']
  identity_namespace varchar [not null, note: 'faostat_cpc for FAO; otherwise exact dataset ID.']
  source_identity varchar [not null, note: 'Exact CPC, PSD commodity, Yearbook commodity_class, WorldBank commodity_code, or VN commodity. No equivalence/default conversion.']
  source_labels_json varchar [not null, note: 'Sorted distinct exact source labels; preserve aliases without using labels as FAO code identity.']
  identity_kind varchar [not null, note: 'cpc_source_code / source_commodity / price_class / benchmark / market_commodity according to P1; not a fabricated processing stage.']

  indexes {
    (identity_namespace, source_identity) [unique, name: 'uq_dim_source_product_grain']
  }

  Note: '''
GRAIN: One source product/class/benchmark identity within namespace.
NATURAL/ANALYTICAL KEY: (identity_namespace, source_identity).
INPUT DATASETS: faostat_monthly_price, faostat_production, faostat_supply_utilization, faostat_trade, thitruongnongsan, usda_psd, usda_rice_yearbook, worldbank_pinksheet. Physical prefix: iceberg.silver_local.
Exact FAO CPC identity can be shared across FAO sources; F0030 and all other codes remain distinct. No guessed paddy/milled, variety or benchmark equivalence.
MAPPING: source_to_gold_mapping.csv covers every column and source branch.
VALIDATION: README.md DQ gates; mandatory identities must not be collapsed to Unknown.
'''
}

// DIMENSION: One source measurement code/attribute with a verified unit rule.
Table gold_local.dim_observation_type {
  observation_type_key varchar(64) [pk, note: 'SHA-256 K1 typed-array protocol; no increment/row_number; collision gate required.']
  source_system_key varchar(64) [not null, ref: > gold_local.dim_source_system.source_system_key, note: 'K1(dim_source_system,[canonical dataset ID]); source ID is execution context, not guessed from labels.']
  source_metric_id varchar [not null, note: 'Exact element_code or USDA attribute; do not rename source labels.']
  source_labels_json varchar [not null, note: 'Sorted distinct source statistic names; code/name rule must agree.']
  silver_unit varchar [not null, note: 'unit; one verified unit per source metric; fail if FD violated.']
  gold_unit varchar [not null, note: 'U1: tonne/hectare/kg/hectare unchanged; 1000 USD->USD; 1000 MT->tonne; 1000 HA->hectare; MT/HA->tonne/hectare; fraction unchanged.']
  gold_conversion_factor decimal(10,4) [not null, note: 'U1: 1000 for 1000 USD/1000 MT/1000 HA; 1 otherwise; no guessed conversion.']
  aggregation_rule varchar [not null, note: 'A1 explicit metric rule in README: ratio/index/fraction never SUM; stocks not across time; totals not with components; MY/TY separate.']

  indexes {
    (source_system_key, source_metric_id) [unique, name: 'uq_dim_observation_type_grain']
  }

  Note: '''
GRAIN: One source measurement code/attribute with a verified unit rule.
NATURAL/ANALYTICAL KEY: (source_system_key, source_metric_id).
INPUT DATASETS: faostat_production, faostat_supply_utilization, faostat_trade, usda_psd. Physical prefix: iceberg.silver_local.
Type 0 measurement identity; exact code/attribute maps one-to-one to unit/scale/additivity. Conflicting definitions or unrecognized units fail admission.
MAPPING: source_to_gold_mapping.csv covers every column and source branch.
VALIDATION: README.md DQ gates; mandatory identities must not be collapsed to Unknown.
'''
}

// DIMENSION: One exact source price/index/benchmark/quote identity independent of its observation period.
Table gold_local.dim_price_series {
  price_series_key varchar(64) [pk, note: 'SHA-256 K1 typed-array protocol; no increment/row_number; collision gate required.']
  source_system_key varchar(64) [not null, ref: > gold_local.dim_source_system.source_system_key, note: 'K1(dim_source_system,[canonical dataset ID]); source ID is execution context, not guessed from labels.']
  series_identity_json varchar [not null, note: 'Canonical JSON of ordered S1 tuple; VN [market,commodity,price_type,unit,currency,source]; FAO [country_code,commodity_code,element_code]; WB [commodity_code]; Yearbook [location,commodity_class,statistic_type].']
  geography_key varchar(64) [not null, ref: > gold_local.dim_source_geography.geography_key, note: 'G1 exact source identity; WB uses reserved zero-hash non-geographic member, not an inferred exporter country.']
  product_key varchar(64) [not null, ref: > gold_local.dim_source_product.product_key, note: 'P1 exact source product/class/benchmark; exactly one match.']
  price_type_source varchar [note: 'Exact source element/statistic/price_type; WB literal benchmark. No universal wholesale/retail/FOB assumption.']
  unit varchar [not null, note: 'U2: FAO 5530/5531/5532 -> LCU/tonne,SLC/tonne,USD/tonne; 5539 -> index(2014-2016=100); other source normalized unit unchanged.']
  currency varchar [note: 'FAO/VN currency direct; Yearbook USD; WB USD only if unit starts USD/; otherwise NULL (index or unproven currency). No FX.']
  price_kind varchar [not null, note: 'FAO price_kind unchanged; WB index when unit starts index( else benchmark_price; Yearbook reported_export_price; VN market_quote.']
  information_source varchar [note: 'VN exact source; otherwise NULL not applicable. This is not provider/source_id.']

  indexes {
    (source_system_key, series_identity_json) [unique, name: 'uq_dim_price_series_grain']
  }

  Note: '''
GRAIN: One exact source price/index/benchmark/quote identity independent of its observation period.
NATURAL/ANALYTICAL KEY: (source_system_key, series_identity_json).
INPUT DATASETS: faostat_monthly_price, worldbank_pinksheet, usda_rice_yearbook, thitruongnongsan. Physical prefix: iceberg.silver_local.
Source series identity Type 0; descriptive fields FD-checked Type 1. No automatic grade/country/product alias merge. VN keeps all six quote attributes.
MAPPING: source_to_gold_mapping.csv covers every column and source branch.
VALIDATION: README.md DQ gates; mandatory identities must not be collapsed to Unknown.
'''
}

// FACT: One FAOSTAT production observation per area, CPC, calendar year and element.
Table gold_local.fact_fao_production_observation {
  observation_key varchar(64) [pk, note: 'SHA-256 K1 typed-array protocol; no increment/row_number; collision gate required.']
  year_key integer [not null, ref: > gold_local.dim_year.year_key, note: 'dim_year.year_key = source year; actual calendar semantics verified.']
  geography_key varchar(64) [not null, ref: > gold_local.dim_source_geography.geography_key, note: 'G1 exact namespace/scope/source identity; exactly one match; mandatory identity never zero-hash fallback.']
  product_key varchar(64) [not null, ref: > gold_local.dim_source_product.product_key, note: 'P1 exact namespace/source product identity; no cross-source factor or code replacement.']
  observation_type_key varchar(64) [not null, ref: > gold_local.dim_observation_type.observation_type_key, note: 'Exact source dataset and source_metric_id; one match, U1 admitted unit.']
  value decimal(18,2) [note: 'value unchanged; lossless cast to declared Gold decimal. Missing stays NULL; real zero stays zero.']
  source_system_key varchar(64) [not null, ref: > gold_local.dim_source_system.source_system_key, note: 'K1(dim_source_system,[canonical dataset ID]); source ID is execution context, not guessed from labels.']
  missing_reason varchar [note: 'missing_reason; preserve source missing rows and real zeros separately.']
  _ingestion_run_id varchar [not null, note: '_ingestion_run_id; technical lineage column emitted by framework, not inferred from business labels.']
  _ingestion_batch_id varchar [not null, note: '_ingestion_batch_id; technical lineage column emitted by framework, not inferred from business labels.']
  _ingestion_chunk_id bigint [not null, note: '_ingestion_chunk_id; technical lineage column emitted by framework, not inferred from business labels.']
  _ingestion_timestamp timestamptz [not null, note: '_ingestion_timestamp; technical lineage column emitted by framework, not inferred from business labels.']
  _source_id varchar [not null, note: '_source_id; technical lineage column emitted by framework, not inferred from business labels.']
  _source_file varchar [not null, note: '_source_file; technical lineage column emitted by framework, not inferred from business labels.']
  _source_checksum varchar [not null, note: '_source_checksum; technical lineage column emitted by framework, not inferred from business labels.']
  _source_snapshot_id bigint [not null, note: 'Upstream lineage only; may be 0, never use as Silver read snapshot.']
  _silver_processed_at timestamptz [not null, note: '_silver_processed_at; upstream processing time, not publication/availability time.']
  dq_warnings_json varchar [not null, note: 'Deterministic JSON serialization of upstream warning array; [] for empty array, never drop warnings.']
  silver_table_uuid varchar [not null, note: 'Read actual Silver Iceberg table UUID from pinned input metadata; execution admission context, not a source column.']
  silver_read_snapshot_id bigint [not null, note: 'Actual Silver snapshot pinned before reading, required positive; not Bronze snapshot or _source_snapshot_id.']
  source_business_key_json varchar [not null, note: 'Exact ordered Silver business key; retained for collision and row-reconciliation gates.']
  source_context_json varchar [not null, note: 'Canonical deterministic JSON object of exactly [domain_code,domain,country_name,commodity_name,element,unit,flag,flag_description,value_raw,unit_raw]; preserve original NULL, strings and decimals; source flags/evidence are not overwritten.']
  gold_model_version varchar [not null, note: 'Literal gold-20261025.1. Attempt timestamp/UUID is not a content change.']

  indexes {
    (year_key, geography_key, product_key, observation_type_key) [unique, name: 'uq_fact_fao_production_observation_grain']
  }

  Note: '''
GRAIN: One FAOSTAT production observation per area, CPC, calendar year and element.
NATURAL/ANALYTICAL KEY: (year_key, geography_key, product_key, observation_type_key).
INPUT DATASETS: faostat_production. Physical prefix: iceberg.silver_local.
Keep reported yield as non-additive reference. No unsupported animal/seed auxiliary; direct source units already standardized.
MAPPING: source_to_gold_mapping.csv covers every column and source branch.
VALIDATION: README.md DQ gates; mandatory identities must not be collapsed to Unknown.
'''
}

