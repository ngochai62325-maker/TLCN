  release_status varchar [not null, note: 'release_status unchanged; exact current NSO contract semantics.']
  quality_status varchar [not null, note: 'quality_status unchanged; exact current NSO contract semantics.']
  review_reason varchar [note: 'review_reason unchanged; exact current NSO contract semantics.']
  value decimal(28,8) [note: 'value already hectare/tonne/kg/hectare/percent; factor 1 at Gold. Do not multiply 1000/100 again.']
  unit varchar [not null, note: 'unit unchanged; must agree with measure/statistic_kind.']
  value_source decimal(28,8) [note: 'Original numeric source scale preserved, not Gold measure used for normalized sums.']
  silver_conversion_factor decimal(8,0) [not null, note: 'Silver factor as evidence only; never apply it again to Silver value.']
  bronze_read_snapshot_id bigint [not null, note: 'Actual pinned Bronze read snapshot from NSO transformer; distinct from Gold Silver-read snapshot.']
  diagnostic_evidence_json varchar [not null, note: 'Diagnostic JSON string unchanged; discrepancies warn, not a reason to edit source measurements.']
  source_system_key varchar(64) [not null, ref: > gold_local.dim_source_system.source_system_key, note: 'K1(dim_source_system,[canonical dataset ID]); source ID is execution context, not guessed from labels.']
  missing_reason varchar [note: 'missing_reason; preserve source missing rows and real zeros separately.']
