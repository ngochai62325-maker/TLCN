  dq_warnings_json varchar [not null, note: 'Deterministic JSON serialization of upstream warning array; [] for empty array, never drop warnings.']
  silver_table_uuid varchar [not null, note: 'Read actual Silver Iceberg table UUID from pinned input metadata; execution admission context, not a source column.']
  silver_read_snapshot_id bigint [not null, note: 'Actual Silver snapshot pinned before reading, required positive; not Bronze snapshot or _source_snapshot_id.']
  source_business_key_json varchar [not null, note: 'Exact ordered Silver business key; retained for collision and row-reconciliation gates.']
  source_context_json varchar [not null, note: 'Canonical deterministic JSON object of exactly [unit,value_source,source_unit,conversion_factor,value_raw]; preserve original NULL, strings and decimals; source flags/evidence are not overwritten.']
  gold_model_version varchar [not null, note: 'Literal gold-20261025.1. Attempt timestamp/UUID is not a content change.']

  indexes {
    (geography_key, product_key, observation_type_key, market_year) [unique, name: 'uq_fact_usda_psd_observation_grain']
