// FACT: One source_table, source_geography_key, year, measure, season and statistic_kind observation.
Table gold_local.fact_nso_observation {
  observation_key varchar(64) [pk, note: 'SHA-256 K1 typed-array protocol; no increment/row_number; collision gate required.']
  year_key integer [not null, ref: > gold_local.dim_year.year_key, note: 'dim_year.year_key = source year; actual calendar semantics verified.']
  geography_key varchar(64) [not null, ref: > gold_local.dim_source_geography.geography_key, note: 'G1 exact namespace/scope/source identity; exactly one match; mandatory identity never zero-hash fallback.']
  source_table varchar [not null, note: 'source_table unchanged; exact current NSO contract semantics.']
  source_geography_key varchar [not null, note: 'source_geography_key unchanged; exact current NSO contract semantics.']
  source_column varchar [not null, note: 'source_column unchanged; exact current NSO contract semantics.']
