EVALUATE
VAR Checks = UNION(
    ROW("Test","overview_total","Passed",NOT ISBLANK([Total Observations]) && ABS(([Total Observations])-(1414527))<=0.000001),
    ROW("Test","overview_numeric","Passed",NOT ISBLANK([Numeric Observations]) && ABS(([Numeric Observations])-(1402167))<=0.000001),
    ROW("Test","overview_null","Passed",NOT ISBLANK([Present NULL]) && ABS(([Present NULL])-(12360))<=0.000001),
    ROW("Test","overview_ratio","Passed",NOT ISBLANK([Numeric Coverage]) && ABS(([Numeric Coverage])-(0.9912620967998489954592595263))<=0.000001),
    ROW("Test","production_1990","Passed",NOT ISBLANK(CALCULATE([Annual Production],CalendarYear[Year]=1990)) && ABS((CALCULATE([Annual Production],CalendarYear[Year]=1990))-(19225100.00000000))<=0.000001),
    ROW("Test","area_1990","Passed",NOT ISBLANK(CALCULATE([Annual Area],CalendarYear[Year]=1990)) && ABS((CALCULATE([Annual Area],CalendarYear[Year]=1990))-(6042800.00000000))<=0.000001),
    ROW("Test","production_2015","Passed",NOT ISBLANK(CALCULATE([Annual Production],CalendarYear[Year]=2015)) && ABS((CALCULATE([Annual Production],CalendarYear[Year]=2015))-(45091000.00000000))<=0.000001),
    ROW("Test","area_2015","Passed",NOT ISBLANK(CALCULATE([Annual Area],CalendarYear[Year]=2015)) && ABS((CALCULATE([Annual Area],CalendarYear[Year]=2015))-(7828000.00000000))<=0.000001),
    ROW("Test","production_2024","Passed",NOT ISBLANK(CALCULATE([Annual Production],CalendarYear[Year]=2024)) && ABS((CALCULATE([Annual Production],CalendarYear[Year]=2024))-(43451600.00000000))<=0.000001),
    ROW("Test","area_2024","Passed",NOT ISBLANK(CALCULATE([Annual Area],CalendarYear[Year]=2024)) && ABS((CALCULATE([Annual Area],CalendarYear[Year]=2024))-(7127100.00000000))<=0.000001),
    ROW("Test","no_invented_2025","Passed",ISBLANK(CALCULATE([Annual Production],CalendarYear[Year]=2025))),
    ROW("Test","annual_multi_year","Passed",ISBLANK([Annual Production])),
    ROW("Test","reported_yield_2024","Passed",NOT ISBLANK(CALCULATE([Reported Yield],CalendarYear[Year]=2024)) && ABS((CALCULATE([Reported Yield],CalendarYear[Year]=2024))-(6100))<=0.000001),
    ROW("Test","observed_peak","Passed",NOT ISBLANK([Peak Production]) && ABS(([Peak Production])-(45091000))<=0.000001),
    ROW("Test","observed_peak_year","Passed",NOT ISBLANK([Peak Year]) && ABS(([Peak Year])-(2015))<=0.000001),
    ROW("Test","calendar_yoy","Passed",NOT ISBLANK(CALCULATE([Production YoY],CalendarYear[Year]=2024)) && ABS((CALCULATE([Production YoY],CalendarYear[Year]=2024))-(-0.0010598261517275626067585183))<=0.000001),
    ROW("Test","latest_yoy","Passed",NOT ISBLANK([Latest Production YoY]) && ABS(([Latest Production YoY])-(-0.0010598261517275626067585183))<=0.000001),
    ROW("Test","first_endpoint","Passed",NOT ISBLANK([First Production]) && ABS(([First Production])-(19225100))<=0.000001),
    ROW("Test","last_endpoint","Passed",NOT ISBLANK([Latest Production]) && ABS(([Latest Production])-(43451600))<=0.000001),
    ROW("Test","endpoint_change","Passed",NOT ISBLANK([Production Change Pct]) && ABS(([Production Change Pct])-(1.260149492070262313329969675))<=0.000001),
    ROW("Test","weighted_four_areas","Passed",NOT ISBLANK(CALCULATE([FAO Weighted Yield],CalendarYear[Year]=2024)) && ABS((CALCULATE([FAO Weighted Yield],CalendarYear[Year]=2024))-(4412.490235462011553593335145))<=0.000001),
    ROW("Test","weighted_vietnam","Passed",NOT ISBLANK(CALCULATE([FAO Weighted Yield],CalendarYear[Year]=2024,FAO[area_code]="704")) && ABS((CALCULATE([FAO Weighted Yield],CalendarYear[Year]=2024,FAO[area_code]="704"))-(6151.655790594987096522092215))<=0.000001),
    ROW("Test","weighted_multiple_years","Passed",ISBLANK([FAO Weighted Yield])),
    ROW("Test","SUA_Food_Supply","Passed",NOT ISBLANK(CALCULATE([SUA Food Supply],CalendarYear[Year]=2023)) && ABS((CALCULATE([SUA Food Supply],CalendarYear[Year]=2023))-(13837660.13))<=0.000001),
    ROW("Test","SUA_Opening_Stocks","Passed",NOT ISBLANK(CALCULATE([SUA Opening Stocks],CalendarYear[Year]=2023)) && ABS((CALCULATE([SUA Opening Stocks],CalendarYear[Year]=2023))-(6113011.31))<=0.000001),
    ROW("Test","SUA_Stock_Variation","Passed",NOT ISBLANK(CALCULATE([SUA Stock Variation],CalendarYear[Year]=2023)) && ABS((CALCULATE([SUA Stock Variation],CalendarYear[Year]=2023))-(-222239.24))<=0.000001),
    ROW("Test","stock_no_time_sum","Passed",ISBLANK([SUA Opening Stocks])),
    ROW("Test","PSD_Production","Passed",NOT ISBLANK(CALCULATE([PSD Production],PSD[market_year]=2025)) && ABS((CALCULATE([PSD Production],PSD[market_year]=2025))-(26200000.0000))<=0.000001),
    ROW("Test","PSD_Consumption","Passed",NOT ISBLANK(CALCULATE([PSD Consumption],PSD[market_year]=2025)) && ABS((CALCULATE([PSD Consumption],PSD[market_year]=2025))-(22250000.0000))<=0.000001),
    ROW("Test","PSD_Ending_Stocks","Passed",NOT ISBLANK(CALCULATE([PSD Ending Stocks],PSD[market_year]=2025)) && ABS((CALCULATE([PSD Ending Stocks],PSD[market_year]=2025))-(2297000.0000))<=0.000001),
    ROW("Test","PSD_stock_multi_year","Passed",ISBLANK([PSD Ending Stocks])),
    ROW("Test","WB_peak_month","Passed",NOT ISBLANK(CALCULATE([WB Price],BenchmarkMonth[Date]=DATE(2008,4,1))) && ABS((CALCULATE([WB Price],BenchmarkMonth[Date]=DATE(2008,4,1)))-(907))<=0.000001),
    ROW("Test","WB_min_month","Passed",NOT ISBLANK(CALCULATE([WB Price],BenchmarkMonth[Date]=DATE(2001,4,1))) && ABS((CALCULATE([WB Price],BenchmarkMonth[Date]=DATE(2001,4,1)))-(163.75))<=0.000001),
    ROW("Test","WB_level_multi_month","Passed",ISBLANK([WB Price])),
    ROW("Test","WB_peak","Passed",NOT ISBLANK([WB Peak]) && ABS(([WB Peak])-(907))<=0.000001),
    ROW("Test","WB_minimum","Passed",NOT ISBLANK([WB Minimum]) && ABS(([WB Minimum])-(163.75))<=0.000001),
    ROW("Test","WB_volatility","Passed",NOT ISBLANK(CALCULATE([WB Volatility],BenchmarkMonth[Date]=DATE(2009,1,1))) && ABS((CALCULATE([WB Volatility],BenchmarkMonth[Date]=DATE(2009,1,1)))-(0.17473855800148286))<=0.000001),
    ROW("Test","WB_mom","Passed",NOT ISBLANK(CALCULATE([WB MoM],BenchmarkMonth[Date]=DATE(2009,1,1))) && ABS((CALCULATE([WB MoM],BenchmarkMonth[Date]=DATE(2009,1,1)))-(0.090635577284693493794659646))<=0.000001),
    ROW("Test","quote_dates","Passed",NOT ISBLANK([Domestic Quoted Dates]) && ABS(([Domestic Quoted Dates])-(484))<=0.000001),
    ROW("Test","quote_multi_date","Passed",ISBLANK([Domestic Quote])),
    ROW("Test","Trade_Quantity","Passed",NOT ISBLANK([Trade Quantity]) && ABS(([Trade Quantity])-(17966768.23))<=.01),
    ROW("Test","Trade_Value","Passed",NOT ISBLANK([Trade Value]) && ABS(([Trade Value])-(8824279000.00))<=.01),
    ROW("Test","Trade_Paired_Quantity","Passed",NOT ISBLANK([Trade Paired Quantity]) && ABS(([Trade Paired Quantity])-(17966768.23))<=.01),
    ROW("Test","Trade_Paired_Value","Passed",NOT ISBLANK([Trade Paired Value]) && ABS(([Trade Paired Value])-(8824279000.00))<=.01),
    ROW("Test","trade_ratio_multi_partner_multi_year","Passed",NOT ISBLANK([Trade Unit Value]) && ABS(([Trade Unit Value])-(491.1444777957154067434641806))<=0.000001),
    ROW("Test","trade_philippines_2019","Passed",NOT ISBLANK(CALCULATE([Trade Unit Value],CalendarYear[Year]=2019,Trade[partner_code]="608")) && ABS((CALCULATE([Trade Unit Value],CalendarYear[Year]=2019,Trade[partner_code]="608"))-(414.9598816799164129860020114))<=0.000001),
    ROW("Test","trade_philippines_2023","Passed",NOT ISBLANK(CALCULATE([Trade Unit Value],CalendarYear[Year]=2023,Trade[partner_code]="608")) && ABS((CALCULATE([Trade Unit Value],CalendarYear[Year]=2023,Trade[partner_code]="608"))-(560.8780392330400519332893235))<=0.000001),
    ROW("Test","no_trade_2024","Passed",ISBLANK(CALCULATE([Trade Quantity],CalendarYear[Year]=2024))),
    ROW("Test","empty_trade_group_count","Passed",NOT ISBLANK(CALCULATE([Trade Paired Groups],CalendarYear[Year]=2024)) && ABS((CALCULATE([Trade Paired Groups],CalendarYear[Year]=2024))-(0))<=0.000001),
    ROW("Test","WB_absent_count","Passed",NOT ISBLANK([WB Absent Months]) && ABS(([WB Absent Months])-(0))<=0.000001),
    ROW("Test","FAO_common_year","Passed",NOT ISBLANK([FAO Common Year]) && ABS(([FAO Common Year])-(2024))<=0.000001),
    ROW("Test","FAO_selected_rank_sum","Passed",NOT ISBLANK(SUMX(SUMMARIZECOLUMNS(FAO[area_name],"rank",[FAO Common Rank]),[rank])) && ABS((SUMX(SUMMARIZECOLUMNS(FAO[area_name],"rank",[FAO Common Rank]),[rank]))-(10))<=0.000001),
    ROW("Test","trade_multi_year_156","Passed",NOT ISBLANK(CALCULATE([Trade Unit Value],Trade[partner_code]="156")) && ABS((CALCULATE([Trade Unit Value],Trade[partner_code]="156"))-(532.7923998086077434801876923))<=0.000001),
    ROW("Test","trade_multi_year_458","Passed",NOT ISBLANK(CALCULATE([Trade Unit Value],Trade[partner_code]="458")) && ABS((CALCULATE([Trade Unit Value],Trade[partner_code]="458"))-(447.3335424158326225667366851))<=0.000001),
    ROW("Test","trade_multi_year_608","Passed",NOT ISBLANK(CALCULATE([Trade Unit Value],Trade[partner_code]="608")) && ABS((CALCULATE([Trade Unit Value],Trade[partner_code]="608"))-(489.3793313454051795068599927))<=0.000001),
    ROW("Test","selected_endpoints_2015_2024","Passed",NOT ISBLANK(CALCULATE([Production Change Pct],CalendarYear[Year] IN {2015,2024})) && ABS((CALCULATE([Production Change Pct],CalendarYear[Year] IN {2015,2024}))-(-0.0363575879887338936816659644))<=0.000001),
    ROW("Test","single_year_change_blank","Passed",ISBLANK(CALCULATE([Production Change Pct],CalendarYear[Year]=1990))),
    ROW("Test","single_year_card_label","Passed",CALCULATE([Production Change Pct Display],CalendarYear[Year]=1990)="Không áp dụng")
)
RETURN ROW("Tests",COUNTROWS(Checks),"Failures",COALESCE(COUNTROWS(FILTER(Checks,NOT [Passed])),0),"Failed tests",CONCATENATEX(FILTER(Checks,NOT [Passed]),[Test],", "))
