table VNQuote
	lineageTag: fdd0fe18-3055-4599-b137-4be640656936

	column date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 948acd2c-b668-4e2c-9a88-7ecc9cf57857
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		lineageTag: 2f9a305b-044a-4b74-97d8-014f232fe837
		summarizeBy: none
