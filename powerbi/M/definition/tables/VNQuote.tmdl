table VNQuote
	lineageTag: c12b294a-108e-41b8-86f3-c3f801623198

	column date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: d644eb70-ad8d-4f75-9754-79ac1077978d
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		lineageTag: 1e08055b-15e2-46c6-954b-a632860d8580
		summarizeBy: none
		sourceColumn: year

	column series_key
		dataType: string
		lineageTag: 980f0e45-649a-44a7-ad2a-9c5da40ab507
		summarizeBy: none
		sourceColumn: series_key

	column market
		dataType: string
		lineageTag: 9cbad132-863c-41dc-86ef-53f62ef4910b
		summarizeBy: none
		sourceColumn: market

	column commodity
		dataType: string
		lineageTag: def9840c-88fb-4c5e-90cd-28272d822f93
		summarizeBy: none
		sourceColumn: commodity

	column price_type
		dataType: string
		lineageTag: 3de20eab-5cf2-4295-96a6-be5218fa246c
		summarizeBy: none
		sourceColumn: price_type

	column unit
		dataType: string
		lineageTag: af61dc28-ea4d-46d3-9763-34176909a7b5
		summarizeBy: none
		sourceColumn: unit

	column currency
		dataType: string
		lineageTag: cf59e1d6-fc8a-4244-81cf-0d169073f28d
		summarizeBy: none
		sourceColumn: currency

	column information_source
		dataType: string
		lineageTag: 72569a18-f726-4067-b328-01c909b1c13b
		summarizeBy: none
		sourceColumn: information_source

	column price_vnd_kg
		dataType: double
		lineageTag: f92b71f4-cdc4-403a-a9fc-8cbdbf508bfc
		summarizeBy: none
		sourceColumn: price_vnd_kg

	column observation_present
		dataType: boolean
		lineageTag: 1d0cbc92-0e6e-4962-8444-6cea4d4fa2c3
		summarizeBy: none
		sourceColumn: observation_present

	column numeric_present
		dataType: boolean
		lineageTag: e688da86-68f8-4fee-b12c-5dc320e7b5a2
		summarizeBy: none
		sourceColumn: numeric_present

	column days_since_previous_quote
		dataType: int64
		lineageTag: fd0731c2-a528-434b-b6de-71d69a85fd8a
		summarizeBy: none
		sourceColumn: days_since_previous_quote

	column series_label
		dataType: string
		lineageTag: e72e2c0b-d2c7-4ffb-9d86-628cb679a995
		summarizeBy: none
		sourceColumn: series_label

	partition VNQuote = m
		mode: import
		source =
				let
				    Raw = Csv.Document(File.Contents(ExportFolder & "\vn_quote.csv"), [Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
				    Checked = if Table.ColumnNames(Headers) = {"date", "year", "series_key", "market", "commodity", "price_type", "unit", "currency", "information_source", "price_vnd_kg", "observation_present", "numeric_present", "days_since_previous_quote"} then Headers else error "CSV schema mismatch",
				    Missing = Table.ReplaceValue(Checked, "", null, Replacer.ReplaceValue, Table.ColumnNames(Checked)),
				    Typed = Table.TransformColumnTypes(Missing, {{"date", type date}, {"year", Int64.Type}, {"series_key", type text}, {"market", type text}, {"commodity", type text}, {"price_type", type text}, {"unit", type text}, {"currency", type text}, {"information_source", type text}, {"price_vnd_kg", type number}, {"observation_present", type logical}, {"numeric_present", type logical}, {"days_since_previous_quote", Int64.Type}}, "en-US"),
				    Manifest = Json.Document(File.Contents(ExportFolder & "\export_manifest.json")),
				    Entry = Record.Field(Manifest[outputs], "vn_quote.csv"),
				    Accepted = if Manifest[status] = "COMPLETE" and Manifest[format_version] = "powerbi-csv-2" and Table.RowCount(Typed) = Entry[rows] then Typed else error "Verify the immutable mart bundle before refresh",
				    With_series_label = Table.AddColumn(Accepted, "series_label", each [commodity] & " · " & [price_type], type text)
				in
				    With_series_label

	annotation PBI_ResultType = Table

