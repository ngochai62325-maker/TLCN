		lineageTag: 51f4cd61-94db-4b3d-907b-fd7812d3b143
		summarizeBy: none
		sourceColumn: unit

	column currency
		dataType: string
		lineageTag: 566cf991-6427-4883-9488-db0c9fb679a9
		summarizeBy: none
