	/// Giá Gạo Việt Nam 5% mới nhất.
	measure 'Latest WB VN 5 Price' = VAR m = MAXX(FILTER(ALL(WB), WB[series_code] = "rice_viet_namese_5" && NOT ISBLANK(WB[price_usd_t])), WB[month_date]) RETURN CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_viet_namese_5", WB[month_date] = m)
		formatString: #,0.00
		lineageTag: 4b3b75cc-c44c-454a-afae-3429ca7b69fb

	/// Biến động MoM Gạo Việt Nam 5% mới nhất.
	measure 'Latest WB VN 5 MoM' = VAR m = MAXX(FILTER(ALL(WB), WB[series_code] = "rice_viet_namese_5" && NOT ISBLANK(WB[price_usd_t])), WB[month_date]) RETURN CALCULATE(MAX(WB[monthly_change_pct]) / 100, REMOVEFILTERS(WB), WB[series_code] = "rice_viet_namese_5", WB[month_date] = m)
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 772c0602-8d8e-4d32-aad4-3d90d5fe893c

	/// Thẻ giá Việt Nam 5% mới nhất kèm MoM.
	measure 'Latest WB VN 5 Display' = FORMAT([Latest WB VN 5 Price], "$#,0.00") & " /tấn (" & FORMAT([Latest WB VN 5 MoM], "+0.00%;-0.00%") & ")"
		formatString: @
		lineageTag: e48ca645-d6d7-4a39-9cfe-23e7598ea67f

	/// Tháng mới nhất chung có giá của cả Thái 5% và VN 5%.
	measure 'Latest Common WB Month' = MAXX(FILTER(ALL(WB[month_date]), VAR m = WB[month_date] RETURN CALCULATE(COUNTROWS(WB), REMOVEFILTERS(WB), WB[month_date] = m, WB[series_code] = "rice_thai_5", NOT ISBLANK(WB[price_usd_t])) > 0 && CALCULATE(COUNTROWS(WB), REMOVEFILTERS(WB), WB[month_date] = m, WB[series_code] = "rice_viet_namese_5", NOT ISBLANK(WB[price_usd_t])) > 0), WB[month_date])
		formatString: yyyy-MM-dd
		lineageTag: e6e3bd90-0745-4270-ba80-c8554c04ff8b

	/// Chênh lệch giá World Bank: Việt Nam 5% − Thái 5% (USD/tấn).
	measure 'WB Spread VN5 vs Thai5' = VAR m = [Latest Common WB Month] VAR vn = CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_viet_namese_5", WB[month_date] = m) VAR thai = CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_thai_5", WB[month_date] = m) RETURN IF(NOT ISBLANK(vn) && NOT ISBLANK(thai), vn - thai)
		formatString: #,0.00
		lineageTag: e4d6fc10-eac6-433c-99f2-93c5ff8ffea6

	/// Thẻ chênh lệch giá VN 5% − Thái 5%.
	measure 'WB Spread VN5 vs Thai5 Display' = IF(ISBLANK([WB Spread VN5 vs Thai5]), "Không áp dụng", FORMAT([WB Spread VN5 vs Thai5], "+$#,0.00;-$#,0.00;$0.00") & " /tấn")
		formatString: @
		lineageTag: a82a4a2f-a4f3-4de5-8060-304be647f55d

	/// Tiêu đề động biểu đồ phân tán diện tích – sản lượng.
	measure 'FAO Scatter Title' = IF(ISBLANK([FAO Scatter Year]), "[Lúa] Diện tích và sản lượng · Không áp dụng", "[Lúa] Diện tích và sản lượng (năm " & FORMAT([FAO Scatter Year], "0") & ")")
		formatString: @
		lineageTag: c7ced1e2-3be1-4351-a0e6-c944762b967c

	/// Biến động MoM: 2 chuỗi 5% đối sánh mặc định khi chưa lọc, hoặc chuỗi được chọn trên slicer.
	measure 'WB MoM Comparison' = VAR selected_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALLSELECTED(WB), REMOVEFILTERS(BenchmarkMonth)) VAR total_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALL(WB)) VAR cur_code = SELECTEDVALUE(WB[series_code]) RETURN IF(NOT ISBLANK(cur_code) && (selected_cnt < total_cnt || cur_code IN {"rice_thai_5", "rice_viet_namese_5"}), [WB MoM])
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 106fc938-4469-42d0-87a8-d653f65041e2

	/// Độ biến động 12M: 2 chuỗi 5% đối sánh mặc định khi chưa lọc, hoặc chuỗi được chọn trên slicer.
	measure 'WB Volatility Comparison' = VAR selected_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALLSELECTED(WB), REMOVEFILTERS(BenchmarkMonth)) VAR total_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALL(WB)) VAR cur_code = SELECTEDVALUE(WB[series_code]) RETURN IF(NOT ISBLANK(cur_code) && (selected_cnt < total_cnt || cur_code IN {"rice_thai_5", "rice_viet_namese_5"}), [WB Volatility])
		formatString: 0.00%
		lineageTag: 61d2d653-6672-4a0b-8b2e-17586cf458df

	/// Tiêu đề động biểu đồ MoM.
	measure 'WB MoM Title' = IF(HASONEVALUE(WB[series_code]), "[Gạo xay xát] Biến động MoM – " & SELECTEDVALUE(WB[series_name_vi]) & " (%)", "[Gạo xay xát] Biến động MoM – Gạo Thái 5% & VN 5% (%)")
		formatString: @
		lineageTag: 7f18d943-2f1d-4abf-bbaa-53f27bf68bbd

	/// Tiêu đề động biểu đồ biến động 12M kèm ghi chú khoảng khuyết dữ liệu khi hiển thị chuỗi VN.
	measure 'WB Volatility Title' = IF(HASONEVALUE(WB[series_code]), "[Gạo xay xát] Biến động 12M – " & SELECTEDVALUE(WB[series_name_vi]) & IF(SELECTEDVALUE(WB[series_code]) = "rice_viet_namese_5", " (VN khuyết 12/2005–03/2010)", " (%)"), "[Gạo xay xát] Biến động 12M – Thái 5% & VN 5% (VN khuyết 12/2005–03/2010)")
		formatString: @
		lineageTag: 7c01c7cc-3377-4f17-bd12-6eee886c89f0

	/// Vietnam domestic quote VND/kg; guardrail: yêu cầu chọn đúng 1 giống lúa và 1 loại giá xác định.
	measure 'Domestic Quote' = IF(HASONEVALUE(VNQuote[commodity]) && HASONEVALUE(VNQuote[price_type]), IF(HASONEVALUE(QuoteDate[Date]), MAX(VNQuote[price_vnd_kg]), AVERAGE(VNQuote[price_vnd_kg])))
		formatString: #,0
		lineageTag: 9f945d31-00ee-4b88-a0f7-86a9cfd17e8f

	/// Số ngày có báo giá duy nhất trong phạm vi chọn.
	measure 'Domestic Quoted Dates' = DISTINCTCOUNT(VNQuote[date])
		formatString: #,0
		lineageTag: abbffffc-cfe9-442e-9b76-a299d803b572

	/// Giá nội địa theo chuỗi chọn trên slicer (mặc định IR 50404 tươi · Thương lái thu mua); lọc bỏ giá < 1000 VND/kg và trả BLANK() khi thiếu quan sát.
	measure 'Domestic Quote Chart Price' = VAR chosen_series = IF(ISFILTERED(VNQuote[series_label]) && COUNTROWS(FILTERS(VNQuote[series_label])) = 1, MAXX(FILTERS(VNQuote[series_label]), VNQuote[series_label]), "Lúa IR 50404 (lúa tươi) · Thương lái thu mua") VAR valid_rows = FILTER(VNQuote, VNQuote[series_label] = chosen_series && NOT ISBLANK(VNQuote[price_vnd_kg]) && VNQuote[price_vnd_kg] >= 1000) RETURN IF(COUNTROWS(valid_rows) > 0, AVERAGEX(valid_rows, VNQuote[price_vnd_kg]), BLANK())
		formatString: #,0
		lineageTag: 49fc7762-1011-42e5-a0eb-3d8553fb14bd

	/// Tiêu đề động biểu đồ giá nội địa liệt kê đúng chuỗi đang chọn và tập thị trường hợp lệ.
	measure 'Domestic Quote Chart Title' = VAR chosen_series = IF(ISFILTERED(VNQuote[series_label]) && COUNTROWS(FILTERS(VNQuote[series_label])) = 1, MAXX(FILTERS(VNQuote[series_label]), VNQuote[series_label]), "Lúa IR 50404 (lúa tươi) · Thương lái thu mua") VAR valid_markets = FILTER(VALUES(VNQuote[market]), CALCULATE(COUNTROWS(VNQuote), VNQuote[series_label] = chosen_series, NOT ISBLANK(VNQuote[price_vnd_kg]), VNQuote[price_vnd_kg] >= 1000) > 0) VAR market_list = CONCATENATEX(valid_markets, VNQuote[market], ", ", VNQuote[market], ASC) RETURN IF(ISBLANK(market_list) || market_list = "", "[Lúa] Giá nội địa – " & chosen_series & " (không có dữ liệu)", "[Lúa] Giá nội địa (" & market_list & ") – " & chosen_series & " (VND/kg)")
		formatString: @
		lineageTag: b301e884-b8db-4316-8d51-5926d641549c

	/// Reported export tonnes; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Quantity' = SUM(Trade[quantity_t])
		formatString: #,0.00
		lineageTag: 0d54da53-ab40-42ba-a784-fef3db855cbc

	/// Reported export USD; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Value' = SUM(Trade[value_usd])
		formatString: #,0.00
		lineageTag: 33594fab-d0be-472f-b860-94b059ffe496

	/// Numeric quantity paired with numeric monetary value and q>0; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Paired Quantity' = SUM(Trade[paired_quantity_t])
		formatString: #,0.00
		lineageTag: 1648cac1-849d-4aee-b063-85c71a78aadf

	/// Same eligible contributor population as paired quantity; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Paired Value' = SUM(Trade[paired_value_usd])
		formatString: #,0.00
		lineageTag: ac52f11f-6c6c-4fd5-ae67-2d59144863cd

	/// USD/tonne = ratio of paired sums under current year/partner selection; never average row ratios; positive paired denominator.
	measure 'Trade Unit Value' = DIVIDE([Trade Paired Value],[Trade Paired Quantity])
		formatString: #,0.00
		lineageTag: c21812a0-6b08-4c2d-85e6-8834fe6b12e0

	/// Số lượng quốc gia đối tác xuất khẩu thực tế trong phạm vi lọc (7 đối tác).
	measure 'Trade Partners' = DISTINCTCOUNT(Trade[partner_name])
		formatString: #,0
		lineageTag: 4d27c3f4-2d0d-4d0f-a307-5f21564e056e

	/// Năm xuất khẩu mới nhất có dữ liệu.
	measure 'Latest Trade Year' = MAXX(FILTER(ALLSELECTED(CalendarYear[Year]), NOT ISBLANK(CALCULATE([Trade Quantity]))), CalendarYear[Year])
		formatString: 0
		lineageTag: 95453ee2-c079-4498-bc51-5e2e67b207c1

	/// Reported export tonnes in latest selected year.
	measure 'Latest Trade Quantity' = VAR y=[Latest Trade Year] RETURN IF(NOT ISBLANK(y), CALCULATE([Trade Quantity], REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0.00
		lineageTag: a3752c77-70d7-462b-a8de-541eb0cca7cb

	/// Eligible paired reporter-partner-product-year groups; coverage of selected partner scope (35 cặp).
	measure 'Trade Paired Groups' = COALESCE(COUNTROWS(FILTER(Trade, NOT ISBLANK(Trade[paired_quantity_t]) && NOT ISBLANK(Trade[paired_value_usd]))), 0)
		formatString: #,0
		lineageTag: 7f4bf24a-d1c2-46e0-8b5d-91ba3b7068e1

	/// Dynamic paired coverage and ratio; no global denominator.
	measure 'Trade Insight' = IF([Trade Paired Groups]=0,"Không có cặp đủ điều kiện trong phạm vi chọn.","Việt Nam → " & CONCATENATEX(VALUES(Trade[partner_name_vi]),Trade[partner_name_vi],", ") & " · " & FORMAT(MIN(Trade[year]),"0") & "–" & FORMAT(MAX(Trade[year]),"0") & " · CPC23161.02. " & FORMAT([Trade Partners],"0") & " đối tác (" & FORMAT([Trade Paired Groups],"0") & " cặp năm–đối tác); đơn giá bình quân " & FORMAT([Trade Unit Value],"#,0.00") & " USD/t. Tỷ số giá trị/lượng báo cáo; không phải giá thị trường độc lập.")
		formatString: @
		lineageTag: a140d7ba-eb44-4c22-b3eb-a89f7a394483

	/// Sản lượng kỳ đầu triệu tấn.
