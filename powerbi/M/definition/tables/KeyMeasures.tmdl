	/// Giá Gạo Thái 5% mới nhất.
	measure 'Latest WB Thai 5 Price' = VAR m = MAXX(FILTER(ALL(WB), WB[series_code] = "rice_thai_5" && NOT ISBLANK(WB[price_usd_t])), WB[month_date]) RETURN CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_thai_5", WB[month_date] = m)
		formatString: #,0.00
		lineageTag: 64323052-3373-4fdc-af77-7ba9cb765417

	/// Biến động MoM Gạo Thái 5% mới nhất.
	measure 'Latest WB Thai 5 MoM' = VAR m = MAXX(FILTER(ALL(WB), WB[series_code] = "rice_thai_5" && NOT ISBLANK(WB[price_usd_t])), WB[month_date]) RETURN CALCULATE(MAX(WB[monthly_change_pct]) / 100, REMOVEFILTERS(WB), WB[series_code] = "rice_thai_5", WB[month_date] = m)
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: c4047db4-d425-4c67-8ebc-909b1191ad4a

	/// Thẻ giá Thái 5% mới nhất kèm MoM.
