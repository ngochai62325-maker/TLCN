		formatString: @
		lineageTag: f36b05c2-ebcc-417e-b178-4eb84ea65a11

	/// Thay đổi diện tích đầu–cuối.
	measure 'Area Change Pct Display' = IF(ISBLANK([Area Change Pct]),"Không áp dụng",FORMAT([Area Change Pct],"+0.00%;-0.00%"))
		formatString: @
		lineageTag: b25ab681-a525-4751-9b31-1b46b4b91a90

	/// Thay đổi năng suất đầu–cuối.
	measure 'Yield Change Pct Display' = IF(ISBLANK([Yield Change Pct]),"Không áp dụng",FORMAT([Yield Change Pct],"+0.00%;-0.00%"))
		formatString: @
		lineageTag: 58e75a21-d870-472b-ad10-96cd6a0a991e

	/// Formatted export quantity in million tonnes.
	measure 'Trade Quantity Display' = IF(ISBLANK([Trade Quantity]),"Không áp dụng",FORMAT([Trade Quantity]/1000000,"#,0.00") & " tr tấn")
		formatString: @
		lineageTag: 5f4da5ca-f59a-4298-ad7f-40900ec89cfa

	/// Formatted export quantity in million tonnes for latest year.
	measure 'Latest Trade Quantity Display' = VAR y=[Latest Trade Year] RETURN IF(ISBLANK([Latest Trade Quantity]),"Không áp dụng",FORMAT([Latest Trade Quantity]/1000000,"#,0.00") & " tr tấn · " & FORMAT(y,"0"))
		formatString: @
		lineageTag: 2604ef73-61cd-4865-9b99-0c3892ac14f1

	/// Formatted export value in billion USD.
	measure 'Trade Value Display' = IF(ISBLANK([Trade Value]),"Không áp dụng",FORMAT([Trade Value]/1000000000,"$#,0.00") & " tỷ USD")
		formatString: @
		lineageTag: f492b713-3421-4973-b74d-f28adfeb40d1

	/// Formatted unit value USD/tonne.
	measure 'Trade Unit Value Display' = IF(ISBLANK([Trade Unit Value]),"Không áp dụng",FORMAT([Trade Unit Value],"$#,0.00") & " /tấn")
		formatString: @
		lineageTag: 9c438bd3-cea8-4177-9622-f1e452db5d89

	/// Formatted distinct partner count.
	measure 'Trade Partners Display' = IF(ISBLANK([Trade Partners]),"Không áp dụng",FORMAT([Trade Partners],"#,0") & " đối tác")
		formatString: @
		lineageTag: d2006960-ac86-4e27-b0f8-bc209d45f8df

	/// Formatted paired groups count as partner-year pairs.
	measure 'Trade Paired Groups Display' = IF(ISBLANK([Trade Paired Groups]),"Không áp dụng",FORMAT([Trade Paired Groups],"#,0") & " cặp đối tác–năm")
		formatString: @
		lineageTag: e2487d3f-dea7-43eb-ac5e-af78b5c08b08

	/// Đỉnh sản lượng triệu tấn.
	measure 'Peak Production Hero' = IF(ISBLANK([Peak Production]), "Không áp dụng", FORMAT([Peak Production]/1000000, "#,0.00") & " tr tấn")
		formatString: @
		lineageTag: 243e4f4c-eb74-4bb9-b4b9-c78351fcc00e

	/// Năm bắt đầu giai đoạn chọn.
	measure 'First Production Year Ref' = IF(ISBLANK([First Production Year]), "Không áp dụng", "Năm " & FORMAT([First Production Year], "0"))
		formatString: @
		lineageTag: 72ab299b-5daa-48fa-9bcf-09099bfe8eff

	/// Màu chú thích cho First Production Year Ref.
	measure 'First Production Year Ref Color' = "#64748B"
		formatString: @
		lineageTag: 2afbb3a4-0e03-4de1-97b6-1a68f5779b2b

	/// Tăng trưởng YoY kỳ cuối.
	measure 'Latest Production YoY Ref' = VAR v = [Latest Production YoY] RETURN IF(ISBLANK(v), "Không áp dụng", IF(v > 0, "▲ " & FORMAT(v, "0.00%") & " YoY", IF(v < 0, "▼ " & FORMAT(v, "0.00%") & " YoY", "• 0,00%" & " YoY")))
		formatString: @
		lineageTag: ad0dd629-03b8-4b77-8e91-854cfd6d1a58

	/// Màu ngữ nghĩa cho Latest Production YoY Ref.
	measure 'Latest Production YoY Ref Color' = VAR v = [Latest Production YoY] RETURN IF(ISBLANK(v), "#64748B", IF(v > 0, "#16A34A", IF(v < 0, "#DC2626", "#64748B")))
		formatString: @
		lineageTag: 8e4ecb0f-b89e-43cc-8c1d-8ddb52872d96

	/// Mức tăng/giảm tuyệt đối đầu–cuối.
	measure 'Production Change Abs Ref' = IF(ISBLANK([Production Change]), "Không áp dụng", IF([Production Change] > 0, "▲ +" & FORMAT([Production Change]/1000000, "#,0.00") & " tr tấn", IF([Production Change] < 0, "▼ " & FORMAT([Production Change]/1000000, "#,0.00") & " tr tấn", "• 0,00 tr tấn")))
		formatString: @
		lineageTag: 0b60e6f4-53c8-4be8-bd33-78443cc01df5

	/// Màu ngữ nghĩa cho Production Change Abs Ref.
	measure 'Production Change Abs Ref Color' = IF(ISBLANK([Production Change]), "#64748B", IF([Production Change] > 0, "#16A34A", IF([Production Change] < 0, "#DC2626", "#64748B")))
		formatString: @
		lineageTag: ceabc08b-4933-43cf-86ec-552fbf413f97

	/// Kỳ so sánh YoY mới nhất.
	measure 'Latest Production Period Ref' = IF(ISBLANK([Latest Production Year]), "Không áp dụng", IF([Latest Production YoY] >= 0, "▲ ", "▼ ") & FORMAT([Latest Production Year], "0") & " so " & FORMAT([Latest Production Year] - 1, "0"))
		formatString: @
		lineageTag: 4d7a845c-1894-4923-b7eb-8eb48c9ffcca

	/// Năm đạt đỉnh sản lượng.
	measure 'Peak Year Ref' = IF(ISBLANK([Peak Year]), "Không áp dụng", "Kỷ lục năm " & FORMAT([Peak Year], "0"))
