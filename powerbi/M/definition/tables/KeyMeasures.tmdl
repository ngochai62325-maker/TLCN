		formatString: @
		lineageTag: eb43d983-38a0-4d62-a3b0-4f02ff9ca827

	/// Màu ngữ nghĩa cho Latest WB VN 5 MoM Ref.
	measure 'Latest WB VN 5 MoM Ref Color' = VAR v = [Latest WB VN 5 MoM] RETURN IF(ISBLANK(v), "#64748B", IF(v > 0, "#16A34A", IF(v < 0, "#DC2626", "#64748B")))
		formatString: @
		lineageTag: a996a542-b566-4fc8-af92-9ca9aa21aed8

	/// Tháng chung mới nhất.
	measure 'Latest Common WB Ref' = IF(ISBLANK([Latest Common WB Month]), "Không áp dụng", "Kỳ chung: " & FORMAT([Latest Common WB Month], "MM/yyyy"))
