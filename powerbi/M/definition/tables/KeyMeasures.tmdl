	/// Lượng xuất khẩu triệu tấn.
	measure 'Trade Quantity Mil' = [Trade Quantity] / 1000000
		formatString: #,0.00
		lineageTag: 13efe942-6b9d-4b8b-9dd1-75ed755bf641

	/// Giá trị xuất khẩu tỷ USD.
	measure 'Trade Value Bil' = [Trade Value] / 1000000000
		formatString: #,0.00
		lineageTag: 81e6e73c-779a-4470-8835-e4c5c131cbf8

	/// USDA FOB export price reference USD/tonne; guardrail: yêu cầu chọn đúng 1 quốc gia và 1 phẩm cấp.
	measure 'USDA Price' = IF(HASONEVALUE(USDAPrice[location]) && HASONEVALUE(USDAPrice[commodity_class]), IF(HASONEVALUE(USDAPrice[reference_year]), AVERAGE(USDAPrice[price_usd_t]), AVERAGE(USDAPrice[price_usd_t])))
		formatString: #,0.00
		lineageTag: 8bc65e12-9f5a-49eb-a6fa-afb6599962a9

	/// Giá FOB USDA đối sánh 4 nước (mặc định Gạo 5% tấm nếu chưa chọn).
	measure 'USDA FOB Chart Price' = VAR chosen_class = SELECTEDVALUE(USDAPrice[commodity_class], "5-PERCENT BROKEN") RETURN CALCULATE(AVERAGE(USDAPrice[price_usd_t]), KEEPFILTERS(USDAPrice[commodity_class] = chosen_class))
		formatString: #,0.00
		lineageTag: 54b42d8f-bcf6-4703-b935-b6a56751462d

	/// Tiêu đề động biểu đồ giá FOB USDA.
	measure 'USDA FOB Chart Title' = VAR chosen_class_vi = SELECTEDVALUE(USDAPrice[commodity_class_vi]) RETURN IF(ISBLANK(chosen_class_vi), "[Gạo xay xát] Giá FOB USDA – Gạo 5% tấm (đối sánh 4 nước) (USD/tấn)", "[Gạo xay xát] Giá FOB USDA – " & chosen_class_vi & " (USD/tấn)")
		formatString: @
		lineageTag: 7e38ba0a-162e-4032-91b0-532d877fff97

	/// World Bank benchmark monthly USD/tonne level; guardrail: yêu cầu đúng 1 chuỗi giá và 1 tháng.
	measure 'WB Price' = IF(HASONEVALUE(WB[series_code]) && HASONEVALUE(BenchmarkMonth[Date]), MAX(WB[price_usd_t]))
		formatString: #,0.00
		lineageTag: d1bf00dc-8fd6-40d8-8ec4-e905b808a915

	/// Exact calendar previous month for single selected WB series; guardrail cấm trộn chuỗi.
	measure 'WB MoM' = IF(HASONEVALUE(WB[series_code]) && HASONEVALUE(BenchmarkMonth[Date]), MAX(WB[monthly_change_pct])/100)
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 69fc1a41-8fc6-43ab-a4a0-460f1396e156

	/// Trailing 12 log-return sample std for single selected WB series; guardrail cấm trộn chuỗi.
	measure 'WB Volatility' = IF(HASONEVALUE(WB[series_code]) && HASONEVALUE(BenchmarkMonth[Date]), MAX(WB[volatility_12m_pct])/100)
		formatString: 0.00%
		lineageTag: 13826c80-d036-41e5-8f08-1842e96996d3

	/// Observed maximum benchmark in selected months, USD/tonne.
	measure 'WB Peak' = MAXX(ALLSELECTED(BenchmarkMonth[Date]),CALCULATE([WB Price]))
		formatString: #,0.00
		lineageTag: 1ed9e1a2-3ec4-4d17-b657-21f06aa29b22

	/// Observed numeric minimum selected monthly benchmark, USD/tonne.
	measure 'WB Minimum' = MINX(FILTER(ALLSELECTED(BenchmarkMonth[Date]),NOT ISBLANK(CALCULATE([WB Price]))),CALCULATE([WB Price]))
		formatString: #,0.00
		lineageTag: fdafe50a-4fbd-41bd-8ef5-ad320b417bad

	/// Numeric monthly prices in selected calendar; no imputation.
	measure 'WB Numeric Months' = COALESCE(CALCULATE(COUNTROWS(WB),WB[numeric_present]=TRUE()),0)
		formatString: #,0
		lineageTag: e61f4b12-b74c-4909-bc35-1627d12f9244

	/// Count of calendar rows with no source observation.
	measure 'WB Absent Months' = COALESCE(CALCULATE(COUNTROWS(WB),WB[observation_present]=FALSE()),0)
		formatString: #,0
		lineageTag: 2e6a7ef4-f48e-474c-ae7c-01533f2a6137

	/// Tháng mới nhất có giá World Bank trong phạm vi chọn.
	measure 'Latest WB Month' = MAXX(FILTER(ALLSELECTED(BenchmarkMonth[Date]), NOT ISBLANK(CALCULATE(MAX(WB[price_usd_t])))), BenchmarkMonth[Date])
		formatString: @
		lineageTag: deda9cbf-2bbd-45fd-8dcb-3088d388f73d

	/// Mức giá World Bank tại tháng mới nhất của chuỗi đang chọn.
	measure 'Latest WB Price' = VAR m=[Latest WB Month] RETURN IF(NOT ISBLANK(m) && HASONEVALUE(WB[series_code]), CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(BenchmarkMonth), BenchmarkMonth[Date]=m))
		formatString: #,0.00
		lineageTag: 72666ef6-3827-499e-944f-5510eecd5ce0

	/// Thay đổi MoM tại tháng mới nhất của chuỗi đang chọn.
	measure 'Latest WB MoM' = VAR m=[Latest WB Month] RETURN IF(NOT ISBLANK(m) && HASONEVALUE(WB[series_code]), CALCULATE(MAX(WB[monthly_change_pct])/100, REMOVEFILTERS(BenchmarkMonth), BenchmarkMonth[Date]=m))
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: e1c50488-0816-489c-9741-088a4617bd4f

	/// Thẻ giá WB mới nhất kèm MoM.
	measure 'Latest WB Price Display' = IF(ISBLANK([Latest WB Price]), "Chọn 1 chuỗi", FORMAT([Latest WB Price], "$#,0.00") & " /tấn (" & FORMAT([Latest WB MoM], "+0.00%;-0.00%") & ")")
		formatString: @
		lineageTag: 8b525f97-83ca-4f7b-acb0-25d861cd9fb4

	/// Thẻ đỉnh giá WB.
	measure 'WB Peak Display' = IF(ISBLANK([WB Peak]), "Chọn 1 chuỗi", FORMAT([WB Peak], "$#,0.00") & " /tấn")
		formatString: @
		lineageTag: a1f9325c-0c1b-4e35-833a-4e9e0df70f9e

	/// Thẻ đáy giá WB.
	measure 'WB Minimum Display' = IF(ISBLANK([WB Minimum]), "Chọn 1 chuỗi", FORMAT([WB Minimum], "$#,0.00") & " /tấn")
		formatString: @
		lineageTag: e6173d59-4ad7-4d19-a84c-c17634d5907b

	/// Thẻ số tháng có giá WB.
	measure 'WB Numeric Months Display' = FORMAT([WB Numeric Months], "#,0") & " tháng"
		formatString: @
		lineageTag: 012561bc-11f3-45db-b54d-02f419601a3f

	/// Giá Gạo Thái 5% mới nhất.
	measure 'Latest WB Thai 5 Price' = VAR m = MAXX(FILTER(ALL(WB), WB[series_code] = "rice_thai_5" && NOT ISBLANK(WB[price_usd_t])), WB[month_date]) RETURN CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_thai_5", WB[month_date] = m)
		formatString: #,0.00
		lineageTag: dbab0166-41a3-4805-8f79-4bd4b6ce45f3

	/// Biến động MoM Gạo Thái 5% mới nhất.
	measure 'Latest WB Thai 5 MoM' = VAR m = MAXX(FILTER(ALL(WB), WB[series_code] = "rice_thai_5" && NOT ISBLANK(WB[price_usd_t])), WB[month_date]) RETURN CALCULATE(MAX(WB[monthly_change_pct]) / 100, REMOVEFILTERS(WB), WB[series_code] = "rice_thai_5", WB[month_date] = m)
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 65a4523f-3ab1-418a-a914-85fe3d7f5dc2

	/// Thẻ giá Thái 5% mới nhất kèm MoM.
	measure 'Latest WB Thai 5 Display' = FORMAT([Latest WB Thai 5 Price], "$#,0.00") & " /tấn (" & FORMAT([Latest WB Thai 5 MoM], "+0.00%;-0.00%") & ")"
		formatString: @
		lineageTag: 40e5f062-1577-4a10-9f2c-93c34988dd5d

	/// Giá Gạo Việt Nam 5% mới nhất.
	measure 'Latest WB VN 5 Price' = VAR m = MAXX(FILTER(ALL(WB), WB[series_code] = "rice_viet_namese_5" && NOT ISBLANK(WB[price_usd_t])), WB[month_date]) RETURN CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_viet_namese_5", WB[month_date] = m)
		formatString: #,0.00
		lineageTag: f96815a8-b353-4096-83e1-4cca4d82ec92

	/// Biến động MoM Gạo Việt Nam 5% mới nhất.
	measure 'Latest WB VN 5 MoM' = VAR m = MAXX(FILTER(ALL(WB), WB[series_code] = "rice_viet_namese_5" && NOT ISBLANK(WB[price_usd_t])), WB[month_date]) RETURN CALCULATE(MAX(WB[monthly_change_pct]) / 100, REMOVEFILTERS(WB), WB[series_code] = "rice_viet_namese_5", WB[month_date] = m)
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: e7754efb-a0a3-4fca-b396-48014342874a

	/// Thẻ giá Việt Nam 5% mới nhất kèm MoM.
	measure 'Latest WB VN 5 Display' = FORMAT([Latest WB VN 5 Price], "$#,0.00") & " /tấn (" & FORMAT([Latest WB VN 5 MoM], "+0.00%;-0.00%") & ")"
		formatString: @
		lineageTag: 58a484a3-bdc6-47b5-bdd1-0b21e4b2780a

	/// Tháng mới nhất chung có giá của cả Thái 5% và VN 5%.
	measure 'Latest Common WB Month' = MAXX(FILTER(ALL(WB[month_date]), VAR m = WB[month_date] RETURN CALCULATE(COUNTROWS(WB), REMOVEFILTERS(WB), WB[month_date] = m, WB[series_code] = "rice_thai_5", NOT ISBLANK(WB[price_usd_t])) > 0 && CALCULATE(COUNTROWS(WB), REMOVEFILTERS(WB), WB[month_date] = m, WB[series_code] = "rice_viet_namese_5", NOT ISBLANK(WB[price_usd_t])) > 0), WB[month_date])
		formatString: yyyy-MM-dd
		lineageTag: 3cd60041-5b7c-4e77-b178-b5b241b99261

	/// Chênh lệch giá World Bank: Việt Nam 5% − Thái 5% (USD/tấn).
	measure 'WB Spread VN5 vs Thai5' = VAR m = [Latest Common WB Month] VAR vn = CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_viet_namese_5", WB[month_date] = m) VAR thai = CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_thai_5", WB[month_date] = m) RETURN IF(NOT ISBLANK(vn) && NOT ISBLANK(thai), vn - thai)
		formatString: #,0.00
		lineageTag: fd4706c1-f689-4637-8059-06be69266aba

	/// Thẻ chênh lệch giá VN 5% − Thái 5%.
	measure 'WB Spread VN5 vs Thai5 Display' = IF(ISBLANK([WB Spread VN5 vs Thai5]), "Không áp dụng", FORMAT([WB Spread VN5 vs Thai5], "+$#,0.00;-$#,0.00;$0.00") & " /tấn")
		formatString: @
		lineageTag: 151f3461-1698-4db5-a8bf-352041dca6f8

	/// Tiêu đề động biểu đồ phân tán diện tích – sản lượng.
	measure 'FAO Scatter Title' = IF(ISBLANK([FAO Scatter Year]), "[Lúa] Diện tích và sản lượng · Không áp dụng", "[Lúa] Diện tích và sản lượng (năm " & FORMAT([FAO Scatter Year], "0") & ")")
		formatString: @
		lineageTag: 10dcfd48-4dd3-487f-83d2-7462fe7904a3

	/// Biến động MoM: 2 chuỗi 5% đối sánh mặc định khi chưa lọc, hoặc chuỗi được chọn trên slicer.
	measure 'WB MoM Comparison' = VAR selected_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALLSELECTED(WB), REMOVEFILTERS(BenchmarkMonth)) VAR total_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALL(WB)) VAR cur_code = SELECTEDVALUE(WB[series_code]) RETURN IF(NOT ISBLANK(cur_code) && (selected_cnt < total_cnt || cur_code IN {"rice_thai_5", "rice_viet_namese_5"}), [WB MoM])
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: e8011543-2159-433f-8026-78c3d92fc175

	/// Độ biến động 12M: 2 chuỗi 5% đối sánh mặc định khi chưa lọc, hoặc chuỗi được chọn trên slicer.
	measure 'WB Volatility Comparison' = VAR selected_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALLSELECTED(WB), REMOVEFILTERS(BenchmarkMonth)) VAR total_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALL(WB)) VAR cur_code = SELECTEDVALUE(WB[series_code]) RETURN IF(NOT ISBLANK(cur_code) && (selected_cnt < total_cnt || cur_code IN {"rice_thai_5", "rice_viet_namese_5"}), [WB Volatility])
		formatString: 0.00%
		lineageTag: ea121a1c-47a9-48e7-a512-32ba5a3ef9e6

	/// Tiêu đề động biểu đồ MoM.
	measure 'WB MoM Title' = IF(HASONEVALUE(WB[series_code]), "[Gạo xay xát] Biến động MoM – " & SELECTEDVALUE(WB[series_name_vi]) & " (%)", "[Gạo xay xát] Biến động MoM – Gạo Thái 5% & VN 5% (%)")
		formatString: @
		lineageTag: e49dc235-d070-4c88-83ca-e8e4c4b66f22

	/// Tiêu đề động biểu đồ biến động 12M kèm ghi chú khoảng khuyết dữ liệu khi hiển thị chuỗi VN.
	measure 'WB Volatility Title' = IF(HASONEVALUE(WB[series_code]), "[Gạo xay xát] Biến động 12M – " & SELECTEDVALUE(WB[series_name_vi]) & IF(SELECTEDVALUE(WB[series_code]) = "rice_viet_namese_5", " (VN khuyết 12/2005–03/2010)", " (%)"), "[Gạo xay xát] Biến động 12M – Thái 5% & VN 5% (VN khuyết 12/2005–03/2010)")
		formatString: @
		lineageTag: 0cc3f267-604b-4f8d-bfb4-695fd8eb3dbe

	/// Vietnam domestic quote VND/kg; guardrail: yêu cầu chọn đúng 1 giống lúa và 1 loại giá xác định.
	measure 'Domestic Quote' = IF(HASONEVALUE(VNQuote[commodity]) && HASONEVALUE(VNQuote[price_type]), IF(HASONEVALUE(QuoteDate[Date]), MAX(VNQuote[price_vnd_kg]), AVERAGE(VNQuote[price_vnd_kg])))
		formatString: #,0
		lineageTag: fbf357df-10ad-4a16-a11a-9bc5570ff929

	/// Số ngày có báo giá duy nhất trong phạm vi chọn.
	measure 'Domestic Quoted Dates' = DISTINCTCOUNT(VNQuote[date])
		formatString: #,0
		lineageTag: fb996dcd-0787-4dab-89bf-536e4361241e

	/// Giá nội địa theo chuỗi chọn trên slicer (mặc định IR 50404 tươi · Thương lái thu mua); lọc bỏ giá < 1000 VND/kg và trả BLANK() khi thiếu quan sát.
	measure 'Domestic Quote Chart Price' = VAR chosen_series = IF(ISFILTERED(VNQuote[series_label]) && COUNTROWS(FILTERS(VNQuote[series_label])) = 1, MAXX(FILTERS(VNQuote[series_label]), VNQuote[series_label]), "Lúa IR 50404 (lúa tươi) · Thương lái thu mua") VAR valid_rows = FILTER(VNQuote, VNQuote[series_label] = chosen_series && NOT ISBLANK(VNQuote[price_vnd_kg]) && VNQuote[price_vnd_kg] >= 1000) RETURN IF(COUNTROWS(valid_rows) > 0, AVERAGEX(valid_rows, VNQuote[price_vnd_kg]), BLANK())
		formatString: #,0
		lineageTag: 63719bdf-4d02-4e45-ab10-3636bb3b1060

	/// Tiêu đề động biểu đồ giá nội địa liệt kê đúng chuỗi đang chọn và tập thị trường hợp lệ.
	measure 'Domestic Quote Chart Title' = VAR chosen_series = IF(ISFILTERED(VNQuote[series_label]) && COUNTROWS(FILTERS(VNQuote[series_label])) = 1, MAXX(FILTERS(VNQuote[series_label]), VNQuote[series_label]), "Lúa IR 50404 (lúa tươi) · Thương lái thu mua") VAR valid_markets = FILTER(VALUES(VNQuote[market]), CALCULATE(COUNTROWS(VNQuote), VNQuote[series_label] = chosen_series, NOT ISBLANK(VNQuote[price_vnd_kg]), VNQuote[price_vnd_kg] >= 1000) > 0) VAR market_list = CONCATENATEX(valid_markets, VNQuote[market], ", ", VNQuote[market], ASC) RETURN IF(ISBLANK(market_list) || market_list = "", "[Lúa] Giá nội địa – " & chosen_series & " (không có dữ liệu)", "[Lúa] Giá nội địa (" & market_list & ") – " & chosen_series & " (VND/kg)")
		formatString: @
		lineageTag: 648339ca-019a-4b53-9040-adabbcdfa3a5

	/// Reported export tonnes; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Quantity' = SUM(Trade[quantity_t])
		formatString: #,0.00
		lineageTag: c6fbd783-105e-4f1d-aadb-e2463dbb4573

	/// Reported export USD; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Value' = SUM(Trade[value_usd])
		formatString: #,0.00
		lineageTag: 0a290e73-50c4-42d8-8a72-54e811badd62

	/// Numeric quantity paired with numeric monetary value and q>0; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Paired Quantity' = SUM(Trade[paired_quantity_t])
		formatString: #,0.00
		lineageTag: 309f09b2-f39c-4324-826a-0d273f18a845

	/// Same eligible contributor population as paired quantity; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Paired Value' = SUM(Trade[paired_value_usd])
		formatString: #,0.00
		lineageTag: 84081867-7401-4700-b531-be7aa2aa3d0b

	/// USD/tonne = ratio of paired sums under current year/partner selection; never average row ratios; positive paired denominator.
	measure 'Trade Unit Value' = DIVIDE([Trade Paired Value],[Trade Paired Quantity])
		formatString: #,0.00
		lineageTag: 689bea49-1bbb-4069-923a-0cbc2c71f626

	/// Số lượng quốc gia đối tác xuất khẩu thực tế trong phạm vi lọc (7 đối tác).
	measure 'Trade Partners' = DISTINCTCOUNT(Trade[partner_name])
		formatString: #,0
		lineageTag: eff9484e-547b-4742-b09b-edea24d2e7ca

	/// Năm xuất khẩu mới nhất có dữ liệu.
	measure 'Latest Trade Year' = MAXX(FILTER(ALLSELECTED(CalendarYear[Year]), NOT ISBLANK(CALCULATE([Trade Quantity]))), CalendarYear[Year])
		formatString: 0
		lineageTag: 6cc978aa-01d0-4756-b30b-baed4c228d0f

	/// Reported export tonnes in latest selected year.
	measure 'Latest Trade Quantity' = VAR y=[Latest Trade Year] RETURN IF(NOT ISBLANK(y), CALCULATE([Trade Quantity], REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0.00
		lineageTag: 29d28654-40d3-4500-95f3-2a8f381a8c7c

	/// Eligible paired reporter-partner-product-year groups; coverage of selected partner scope (35 cặp).
	measure 'Trade Paired Groups' = COALESCE(COUNTROWS(FILTER(Trade, NOT ISBLANK(Trade[paired_quantity_t]) && NOT ISBLANK(Trade[paired_value_usd]))), 0)
		formatString: #,0
		lineageTag: bf09d7d2-e969-40e5-8499-d39599902196

	/// Dynamic paired coverage and ratio; no global denominator.
	measure 'Trade Insight' = IF([Trade Paired Groups]=0,"Không có cặp đủ điều kiện trong phạm vi chọn.","Việt Nam → " & CONCATENATEX(VALUES(Trade[partner_name_vi]),Trade[partner_name_vi],", ") & " · " & FORMAT(MIN(Trade[year]),"0") & "–" & FORMAT(MAX(Trade[year]),"0") & " · CPC23161.02. " & FORMAT([Trade Partners],"0") & " đối tác (" & FORMAT([Trade Paired Groups],"0") & " cặp năm–đối tác); đơn giá bình quân " & FORMAT([Trade Unit Value],"#,0.00") & " USD/t. Tỷ số giá trị/lượng báo cáo; không phải giá thị trường độc lập.")
		formatString: @
		lineageTag: cf7df63d-ead6-4af5-aab0-c1da7f6b3745

	/// Sản lượng kỳ đầu triệu tấn.
	measure 'First Production Display' = IF(ISBLANK([First Production]),"Không áp dụng",FORMAT([First Production]/1000000,"#,0.00") & " tr tấn")
		formatString: @
		lineageTag: 0ced4197-3f4b-4abf-b6ff-2bf8b1b2fff5

	/// Sản lượng kỳ cuối triệu tấn.
	measure 'Latest Production Display' = IF(ISBLANK([Latest Production]),"Không áp dụng",FORMAT([Latest Production]/1000000,"#,0.00") & " tr tấn")
		formatString: @
