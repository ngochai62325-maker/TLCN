table NSOSeasonal
	lineageTag: 1617abbd-6da6-4e60-9b7a-cfaba6e0deb3

	column year
		dataType: int64
		lineageTag: 0141cd5d-bd56-403e-addc-536ef9766f5a
		summarizeBy: none
