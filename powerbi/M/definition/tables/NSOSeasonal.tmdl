table NSOSeasonal
	lineageTag: 3c3644e3-47a7-406b-b799-436c082d4e79

	column year
		dataType: int64
		lineageTag: f1b19641-4316-4b0a-8175-3078d0e31473
		summarizeBy: none
		sourceColumn: year

	column season
		dataType: string
		lineageTag: 90e8289a-7ca2-4fd6-9745-79d5b1383870
		summarizeBy: none
		sourceColumn: season

	column production_t
		dataType: double
		lineageTag: 6e1234ea-4ef8-4af7-8186-a2ba0324314d
		summarizeBy: none
		sourceColumn: production_t

	column publication
		dataType: string
		lineageTag: f8063acc-11cd-41a9-a2ba-e9438342a901
		summarizeBy: none
