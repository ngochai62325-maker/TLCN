	column season
		dataType: string
		lineageTag: a39e7cb7-6cd8-4ff0-a9ce-6b96161b9434
		summarizeBy: none
		sourceColumn: season

	column production_t
		dataType: double
		lineageTag: a024926a-516a-458c-b6b9-b218b5929a1c
		summarizeBy: none
		sourceColumn: production_t

	column publication
		dataType: string
		lineageTag: 90699ee9-6d39-404d-aad1-644d4553c842
		summarizeBy: none
