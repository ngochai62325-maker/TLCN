table NSOSeasonal
	lineageTag: 301cd93c-7649-4de9-ba7a-3aade96cbc65

	column year
		dataType: int64
		lineageTag: cf026675-44f7-4ba5-9c75-185c3bb4942a
		summarizeBy: none
		sourceColumn: year

	column season
		dataType: string
		lineageTag: d7a0136e-cf21-4d4c-b736-a29320ba76c2
		summarizeBy: none
		sourceColumn: season

	column production_t
		dataType: double
		lineageTag: fe36976f-1c1b-43cd-ae3b-0046e0b7a73e
		summarizeBy: none
		sourceColumn: production_t

	column publication
		dataType: string
		lineageTag: 5616e2a7-8941-43cb-81f4-23fbe92188c4
		summarizeBy: none
		sourceColumn: publication

	column geography_scope
		dataType: string
		lineageTag: 769ec73a-fb97-4a55-ba2c-faa0972c9fa0
		summarizeBy: none
		sourceColumn: geography_scope

	column production_present
		dataType: boolean
		lineageTag: d96ca1f1-fd66-40c4-9f56-38934a7da1ad
