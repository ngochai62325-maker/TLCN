table NSOSeasonal
	lineageTag: 1de1bb53-2af5-4dfe-84af-d660fa990d08

	column year
		dataType: int64
		lineageTag: b773a158-47ce-45ef-b2d7-f93827012551
		summarizeBy: none
		sourceColumn: year

	column season
		dataType: string
		lineageTag: f42b3114-c553-4437-9161-ace0ea922f5a
		summarizeBy: none
		sourceColumn: season

	column production_t
		dataType: double
		lineageTag: f2d08f7e-1e6b-4292-a8f8-76cddfaf2a30
		summarizeBy: none
		sourceColumn: production_t

	column publication
		dataType: string
		lineageTag: f4e844db-3e65-4394-8fa0-fba5cb020f1a
		summarizeBy: none
		sourceColumn: publication

	column geography_scope
		dataType: string
		lineageTag: 0f86f441-fc84-4dd7-8d52-487ec3358a3b
		summarizeBy: none
		sourceColumn: geography_scope

	column production_present
		dataType: boolean
		lineageTag: 9c9b70ae-6dac-4ce9-9903-77ab097ae187
