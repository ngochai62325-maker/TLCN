table NSOAnnual
	lineageTag: 2490d37d-4c34-4dfd-af09-4759bca11c28

	column year
		dataType: int64
		lineageTag: b152f1cd-2c4f-4f8f-be3f-64c53a8941ae
		summarizeBy: none
		sourceColumn: year

	column production_t
		dataType: double
		lineageTag: ec38d46e-f796-4607-9a1b-b786b5649601
		summarizeBy: none
		sourceColumn: production_t

	column area_ha
		dataType: double
		lineageTag: 77b322f3-f02f-432c-a86d-73ffebca1c03
		summarizeBy: none
		sourceColumn: area_ha

	column publication
		dataType: string
		lineageTag: de523981-0bf3-48b7-b8a6-74717a902212
		summarizeBy: none
		sourceColumn: publication

	column geography_scope
		dataType: string
		lineageTag: d9a11193-98f7-4a95-960a-863797657c28
		summarizeBy: none
		sourceColumn: geography_scope

	column production_present
		dataType: boolean
		lineageTag: 0d27de59-7105-41b7-b198-791c91ea54b7
		summarizeBy: none
		sourceColumn: production_present

	column area_present
		dataType: boolean
		lineageTag: 2af9e781-98ea-475a-8b77-ec96f7831985
		summarizeBy: none
		sourceColumn: area_present

	partition NSOAnnual = m
		mode: import
		source =
				let
				    Raw = Csv.Document(File.Contents(ExportFolder & "\nso_national_annual.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
				    Checked = if Table.ColumnNames(Headers) = {"year", "production_t", "area_ha", "publication", "geography_scope", "production_present", "area_present"} then Headers else error "CSV schema mismatch",
				    Missing = Table.ReplaceValue(Checked, "", null, Replacer.ReplaceValue, Table.ColumnNames(Checked)),
				    Typed = Table.TransformColumnTypes(Missing, {{"year", Int64.Type}, {"production_t", type number}, {"area_ha", type number}, {"publication", type text}, {"geography_scope", type text}, {"production_present", type logical}, {"area_present", type logical}}, "en-US"),
				    Manifest = Json.Document(File.Contents(ExportFolder & "\export_manifest.json")),
				    Entry = Record.Field(Manifest[outputs], "nso_national_annual.csv"),
				    Accepted = if Manifest[status] = "COMPLETE" and Manifest[format_version] = "powerbi-csv-2" and Table.RowCount(Typed) = Entry[rows] then Typed else error "Verify the immutable mart bundle before refresh"
				in
				    Accepted

