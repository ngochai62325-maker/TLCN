table USDAPrice
	lineageTag: 9bb1da97-eec7-456f-af2d-a633883a6942

	column reference_year
		dataType: int64
		lineageTag: 6eb3ceea-07c8-4096-bfac-d935f7758e40
		summarizeBy: none
		sourceColumn: reference_year

	column reference_period
		dataType: string
		lineageTag: 7064ee07-b8d2-44fe-b1a0-d632eabbc5b6
		summarizeBy: none
		sourceColumn: reference_period

	column series_key
		dataType: string
		lineageTag: e885c150-61f8-4d99-8724-75ff49852341
		summarizeBy: none
		sourceColumn: series_key

	column location
		dataType: string
		lineageTag: fec0784d-b249-4a81-9352-18c13d84183d
		summarizeBy: none
		sourceColumn: location

	column commodity_class
		dataType: string
		lineageTag: 948f8d80-be47-4d5a-a2a5-73d040d61dbc
		summarizeBy: none
		sourceColumn: commodity_class

	column statistic_type
		dataType: string
		lineageTag: 02169863-550a-4145-bfb4-73997d54871b
		summarizeBy: none
		sourceColumn: statistic_type

	column unit
		dataType: string
		lineageTag: 134849e2-4cd0-45d6-910b-5d5fcfb03439
		summarizeBy: none
		sourceColumn: unit

	column price_usd_t
		dataType: double
		lineageTag: abb1a291-18cb-4eb2-84f5-8908023b8f92
		summarizeBy: none
