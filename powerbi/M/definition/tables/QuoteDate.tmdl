table QuoteDate
	column Date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Date
		formatString: yyyy-MM-dd
	partition QuoteDate = m
		mode: import
		source =
			let lo=List.Min(VNQuote[date]), hi=List.Max(VNQuote[date]), rows=Table.FromList(List.Dates(lo,Duration.Days(hi-lo)+1,#duration(1,0,0,0)),Splitter.SplitByNothing(),{"Date"}) in Table.TransformColumnTypes(rows,{{"Date",type date}})
