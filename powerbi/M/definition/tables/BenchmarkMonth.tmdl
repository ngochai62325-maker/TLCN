table BenchmarkMonth
	lineageTag: e0f96a1b-450a-4767-90bf-2676b6814e40

	column Date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: d75f069e-788a-4bf5-8ddb-8f292fcb2cf1
		summarizeBy: none
		sourceColumn: Date

	partition BenchmarkMonth = m
		mode: import
		source = Table.RenameColumns(Table.Distinct(Table.SelectColumns(WB,{"month_date"})),{{"month_date","Date"}})

