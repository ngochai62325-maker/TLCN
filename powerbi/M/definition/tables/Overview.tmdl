		formatString: @
		lineageTag: 3b144a7d-9862-4eaf-967a-8ccbc1052fbe

	/// Formatted paired groups count as partner-year pairs.
	measure 'Trade Paired Groups Display' = IF(ISBLANK([Trade Paired Groups]),"Không áp dụng",FORMAT([Trade Paired Groups],"#,0") & " cặp đối tác–năm")
		formatString: @
		lineageTag: 786b2c68-e30a-49fc-8f9d-eb97ea33a23a

	/// Tỷ lệ quan sát khuyết trên tổng quan sát.
	measure 'Null Percentage' = DIVIDE([Present NULL], [Total Observations])
		formatString: 0.00%
		lineageTag: 14337fd4-cb9a-488a-b5da-6c2e61374f62

	/// Tỷ lệ quan sát khuyết cao nhất trong 9 fact.
	measure 'Highest Null Fact Pct' = MAXX(Overview, DIVIDE(Overview[present_null_rows], Overview[rows_total]))
		formatString: 0.00%
		lineageTag: a821d681-07f4-4d6b-8165-2c312b05f6af

	/// Tên tiếng Việt và tỷ lệ của fact có tỷ lệ khuyết cao nhất.
	measure 'Highest Null Fact Display' = VAR maxFact = TOPN(1, Overview, DIVIDE(Overview[present_null_rows], Overview[rows_total]), DESC) VAR pct = MAXX(maxFact, DIVIDE(Overview[present_null_rows], Overview[rows_total])) VAR factName = MAXX(maxFact, Overview[fact_name_vi]) RETURN factName & ": " & FORMAT(pct, "0.00%")
		formatString: @
		lineageTag: b63a83da-e676-47b5-a135-443e15fd7370

	/// First selected numeric V06.12 annual area year.
	measure 'First Area Year' = MINX(FILTER(ALLSELECTED(CalendarYear[Year]), NOT ISBLANK(CALCULATE([Annual Area]))), CalendarYear[Year])
		formatString: 0
		lineageTag: ad3dad89-4dc9-451a-80e8-261914ddf4de

	/// Latest selected numeric V06.12 annual area year.
	measure 'Latest Area Year' = MAXX(FILTER(ALLSELECTED(CalendarYear[Year]), NOT ISBLANK(CALCULATE([Annual Area]))), CalendarYear[Year])
		formatString: 0
		lineageTag: dc3c3c26-a4e8-4a04-9ec9-469f336d825c

	/// First numeric selected annual area, V06.12 hectares.
	measure 'First Area' = VAR y=[First Area Year] RETURN IF(NOT ISBLANK(y), CALCULATE([Annual Area], REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0
		lineageTag: 8855a6d0-2724-4d63-bbdd-006034c0b479

	/// Latest numeric selected annual area, V06.12 hectares.
	measure 'Latest Area' = VAR y=[Latest Area Year] RETURN IF(NOT ISBLANK(y), CALCULATE([Annual Area], REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0
		lineageTag: 14c8a995-7fc0-49bf-b33d-2639829cffd1

	/// Tăng trưởng diện tích gieo trồng cả giai đoạn.
	measure 'Area Change Pct' = IF([First Area]>0 && [First Area Year]<[Latest Area Year], DIVIDE([Latest Area]-[First Area], [First Area]))
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: b267e7db-f508-4615-b6bb-f6639a571bd4

	/// First selected numeric V06.14 reported yield year.
	measure 'First Yield Year' = MINX(FILTER(ALLSELECTED(CalendarYear[Year]), NOT ISBLANK(CALCULATE([Reported Yield]))), CalendarYear[Year])
		formatString: 0
		lineageTag: 48b2a4ee-2385-468c-a3ff-8dc50f204e75

	/// Latest selected numeric V06.14 reported yield year.
	measure 'Latest Yield Year' = MAXX(FILTER(ALLSELECTED(CalendarYear[Year]), NOT ISBLANK(CALCULATE([Reported Yield]))), CalendarYear[Year])
		formatString: 0
		lineageTag: 09175f9b-d6b6-4547-94e8-80daa8bac798

	/// First numeric selected reported yield, V06.14 kg/ha.
	measure 'First Yield' = VAR y=[First Yield Year] RETURN IF(NOT ISBLANK(y), CALCULATE([Reported Yield], REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0.00
		lineageTag: f4d91011-ca68-4f3e-b740-07cc78efd1fd

	/// Latest numeric selected reported yield, V06.14 kg/ha.
	measure 'Latest Yield' = VAR y=[Latest Yield Year] RETURN IF(NOT ISBLANK(y), CALCULATE([Reported Yield], REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0.00
		lineageTag: b77c2aa1-4682-4992-8631-be935fd83a93

	/// Tăng trưởng năng suất lúa công bố cả giai đoạn.
	measure 'Yield Change Pct' = IF([First Yield]>0 && [First Yield Year]<[Latest Yield Year], DIVIDE([Latest Yield]-[First Yield], [First Yield]))
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 6d2a8ab7-6ef4-494e-ae4f-d479da83c826

	/// Chỉ số sản lượng lúa so với năm gốc 1961 (1961=100); loại trừ chênh lệch quy mô tuyệt đối.
	measure 'FAO Production Index' = VAR cur=[FAO Production] VAR base=CALCULATE([FAO Production],REMOVEFILTERS(CalendarYear),CalendarYear[Year]=1961) RETURN IF(NOT ISBLANK(cur) && base>0,DIVIDE(cur,base)*100)
		formatString: #,0.00
		lineageTag: a44a4ab3-b2cf-40a7-946b-02619d28d1f0

	/// Tiêu đề động biểu đồ sản lượng lúa theo năm chung.
	measure 'FAO Common Production Title' = "[Lúa] Sản lượng lúa tại năm chung (" & FORMAT([FAO Common Year],"0") & ")"
		formatString: @
		lineageTag: 437a871a-8c53-45dd-a8fc-44fb7be6db1a

	/// Tháng mới nhất có giá World Bank trong phạm vi chọn.
	measure 'Latest WB Month' = MAXX(FILTER(ALLSELECTED(BenchmarkMonth[Date]), NOT ISBLANK(CALCULATE(MAX(WB[price_usd_t])))), BenchmarkMonth[Date])
		formatString: @
