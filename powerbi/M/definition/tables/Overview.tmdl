		formatString: 0
		lineageTag: bfd794fc-549f-4851-8b0e-d7f99c1e889a

	/// First numeric selected reported yield, V06.14 kg/ha.
	measure 'First Yield' = VAR y=[First Yield Year] RETURN IF(NOT ISBLANK(y), CALCULATE([Reported Yield], REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0.00
		lineageTag: 63184e03-1114-4029-b0f9-6fb878d2f898

	/// Latest numeric selected reported yield, V06.14 kg/ha.
	measure 'Latest Yield' = VAR y=[Latest Yield Year] RETURN IF(NOT ISBLANK(y), CALCULATE([Reported Yield], REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0.00
		lineageTag: 95dbec42-9dd1-4e97-8bc0-ea76118d115d

	/// Tăng trưởng năng suất lúa công bố cả giai đoạn.
	measure 'Yield Change Pct' = IF([First Yield]>0 && [First Yield Year]<[Latest Yield Year], DIVIDE([Latest Yield]-[First Yield], [First Yield]))
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 0952f98a-eaf1-4dfa-b20d-403c97ed7051

	/// Chỉ số sản lượng lúa so với năm gốc 1961 (1961=100); loại trừ chênh lệch quy mô tuyệt đối.
	measure 'FAO Production Index' = VAR cur=[FAO Production] VAR base=CALCULATE([FAO Production],REMOVEFILTERS(CalendarYear),CalendarYear[Year]=1961) RETURN IF(NOT ISBLANK(cur) && base>0,DIVIDE(cur,base)*100)
		formatString: #,0.00
		lineageTag: 07a6bab0-8dd5-4aa9-98af-2115de2ee2c2

	/// Tiêu đề động biểu đồ sản lượng lúa theo năm chung.
