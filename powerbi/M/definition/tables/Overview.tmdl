	/// Đỉnh sản lượng triệu tấn.
	measure 'Peak Production Hero' = IF(ISBLANK([Peak Production]), "Không áp dụng", FORMAT([Peak Production]/1000000, "#,0.00") & " tr tấn")
		formatString: @
		lineageTag: 584c8a24-a640-4ef3-801e-e32fab5c84fa

	/// Năm bắt đầu giai đoạn chọn.
	measure 'First Production Year Ref' = IF(ISBLANK([First Production Year]), "Không áp dụng", "Năm " & FORMAT([First Production Year], "0"))
