	/// Màu ngữ nghĩa cho Latest WB VN 5 MoM Ref.
	measure 'Latest WB VN 5 MoM Ref Color' = VAR v = [Latest WB VN 5 MoM] RETURN IF(ISBLANK(v), "#64748B", IF(v > 0, "#16A34A", IF(v < 0, "#DC2626", "#64748B")))
		formatString: @
