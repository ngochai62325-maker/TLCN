	/// Tháng chung mới nhất.
	measure 'Latest Common WB Ref' = IF(ISBLANK([Latest Common WB Month]), "Không áp dụng", "Kỳ chung: " & FORMAT([Latest Common WB Month], "MM/yyyy"))
