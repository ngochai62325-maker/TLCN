		lineageTag: 4661a687-f8a6-4f32-ba38-4d188264c972

	/// Tháng mới nhất chung có giá của cả Thái 5% và VN 5%.
	measure 'Latest Common WB Month' = MAXX(FILTER(ALL(WB[month_date]), VAR m = WB[month_date] RETURN CALCULATE(COUNTROWS(WB), REMOVEFILTERS(WB), WB[month_date] = m, WB[series_code] = "rice_thai_5", NOT ISBLANK(WB[price_usd_t])) > 0 && CALCULATE(COUNTROWS(WB), REMOVEFILTERS(WB), WB[month_date] = m, WB[series_code] = "rice_viet_namese_5", NOT ISBLANK(WB[price_usd_t])) > 0), WB[month_date])
		formatString: yyyy-MM-dd
		lineageTag: 589d93ed-a81d-43ab-bbd0-3b7bdeff7d76

	/// Chênh lệch giá World Bank: Việt Nam 5% − Thái 5% (USD/tấn).
	measure 'WB Spread VN5 vs Thai5' = VAR m = [Latest Common WB Month] VAR vn = CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_viet_namese_5", WB[month_date] = m) VAR thai = CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_thai_5", WB[month_date] = m) RETURN IF(NOT ISBLANK(vn) && NOT ISBLANK(thai), vn - thai)
		formatString: #,0.00
		lineageTag: 5433924e-2b64-45c5-add9-007643abebf3

	/// Thẻ chênh lệch giá VN 5% − Thái 5%.
	measure 'WB Spread VN5 vs Thai5 Display' = IF(ISBLANK([WB Spread VN5 vs Thai5]), "Không áp dụng", FORMAT([WB Spread VN5 vs Thai5], "+$#,0.00;-$#,0.00;$0.00") & " /tấn")
		formatString: @
		lineageTag: 633e00bd-8f36-4d50-8bf4-c6af40079d5f

	/// Biến động MoM: 2 chuỗi 5% đối sánh mặc định khi chưa lọc, hoặc chuỗi được chọn trên slicer.
	measure 'WB MoM Comparison' = VAR selected_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALLSELECTED(WB), REMOVEFILTERS(BenchmarkMonth)) VAR total_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALL(WB)) VAR cur_code = SELECTEDVALUE(WB[series_code]) RETURN IF(NOT ISBLANK(cur_code) && (selected_cnt < total_cnt || cur_code IN {"rice_thai_5", "rice_viet_namese_5"}), [WB MoM])
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: b27f9dfa-70ef-4f9e-8ad9-0ee5f53ce4de

	/// Độ biến động 12M: 2 chuỗi 5% đối sánh mặc định khi chưa lọc, hoặc chuỗi được chọn trên slicer.
	measure 'WB Volatility Comparison' = VAR selected_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALLSELECTED(WB), REMOVEFILTERS(BenchmarkMonth)) VAR total_cnt = CALCULATE(DISTINCTCOUNT(WB[series_code]), ALL(WB)) VAR cur_code = SELECTEDVALUE(WB[series_code]) RETURN IF(NOT ISBLANK(cur_code) && (selected_cnt < total_cnt || cur_code IN {"rice_thai_5", "rice_viet_namese_5"}), [WB Volatility])
		formatString: 0.00%
		lineageTag: 4b5a7c06-200a-4a9e-b64c-af8633f4d63a

	/// Tiêu đề động biểu đồ MoM.
	measure 'WB MoM Title' = IF(HASONEVALUE(WB[series_code]), "[Gạo xay xát] Biến động MoM – " & SELECTEDVALUE(WB[series_name_vi]) & " (%)", "[Gạo xay xát] Biến động MoM – Gạo Thái 5% & VN 5% (%)")
		formatString: @
		lineageTag: d6be42d9-69e6-435a-8061-83b8287ea267

	/// Giá nội địa theo chuỗi chọn trên slicer (mặc định IR 50404 tươi · Thương lái thu mua); lọc bỏ giá < 1000 VND/kg và trả BLANK() khi thiếu quan sát.
	measure 'Domestic Quote Chart Price' = VAR chosen_series = IF(ISFILTERED(VNQuote[series_label]) && COUNTROWS(FILTERS(VNQuote[series_label])) = 1, MAXX(FILTERS(VNQuote[series_label]), VNQuote[series_label]), "Lúa IR 50404 (lúa tươi) · Thương lái thu mua") VAR valid_rows = FILTER(VNQuote, VNQuote[series_label] = chosen_series && NOT ISBLANK(VNQuote[price_vnd_kg]) && VNQuote[price_vnd_kg] >= 1000) RETURN IF(COUNTROWS(valid_rows) > 0, AVERAGEX(valid_rows, VNQuote[price_vnd_kg]), BLANK())
		formatString: #,0
		lineageTag: 328d5b48-1aac-486d-9a2d-5a293f4dad69

	/// Tiêu đề động biểu đồ giá nội địa liệt kê đúng chuỗi đang chọn và tập thị trường hợp lệ.
	measure 'Domestic Quote Chart Title' = VAR chosen_series = IF(ISFILTERED(VNQuote[series_label]) && COUNTROWS(FILTERS(VNQuote[series_label])) = 1, MAXX(FILTERS(VNQuote[series_label]), VNQuote[series_label]), "Lúa IR 50404 (lúa tươi) · Thương lái thu mua") VAR valid_markets = FILTER(VALUES(VNQuote[market]), CALCULATE(COUNTROWS(VNQuote), VNQuote[series_label] = chosen_series, NOT ISBLANK(VNQuote[price_vnd_kg]), VNQuote[price_vnd_kg] >= 1000) > 0) VAR market_list = CONCATENATEX(valid_markets, VNQuote[market], ", ", VNQuote[market], ASC) RETURN IF(ISBLANK(market_list) || market_list = "", "[Lúa] Giá nội địa – " & chosen_series & " (không có dữ liệu)", "[Lúa] Giá nội địa (" & market_list & ") – " & chosen_series & " (VND/kg)")
		formatString: @
		lineageTag: 8c5d58ba-7584-4c03-97fc-ca46201ae22e

	/// Tiêu đề động biểu đồ phân tán diện tích – sản lượng.
	measure 'FAO Scatter Title' = IF(ISBLANK([FAO Scatter Year]), "[Lúa] Diện tích và sản lượng · Không áp dụng", "[Lúa] Diện tích và sản lượng (năm " & FORMAT([FAO Scatter Year], "0") & ")")
		formatString: @
		lineageTag: 933e0150-a597-42ab-a36f-30fd50e0a59c

	/// Phạm vi 9 bảng Fact.
	measure 'Overview Scope Ref' = "9 bảng Fact · Gold layer"
		formatString: @
		lineageTag: 2b4af87d-a423-4e17-b337-9d334fa6ab12

	/// Màu chú thích cho Overview Scope Ref.
	measure 'Overview Scope Ref Color' = "#64748B"
		formatString: @
		lineageTag: f6dbafd1-c315-4e8b-8826-4213b252e1e0

	/// Số quan sát có giá trị số.
	measure 'Overview Numeric Ref' = FORMAT([Numeric Observations], "#,0") & " có số thực"
		formatString: @
		lineageTag: 9faf234d-727e-4e21-b514-4f6b819a7750

	/// Màu chú thích cho Overview Numeric Ref.
	measure 'Overview Numeric Ref Color' = "#16A34A"
		formatString: @
		lineageTag: c10059a5-c72a-4606-b02d-0b143e31759c

	/// Số quan sát khuyết có ghi nhận.
	measure 'Overview Null Ref' = FORMAT([Present NULL], "#,0") & " giá trị NULL"
		formatString: @
		lineageTag: f0911c32-5807-44c9-90f2-e458f7079fb4

	/// Màu chú thích cho Overview Null Ref.
	measure 'Overview Null Ref Color' = "#64748B"
		formatString: @
		lineageTag: 2b023647-acec-4382-898f-8a8923381b78

	/// Tên nguồn có tỷ lệ khuyết cao nhất.
	measure 'Highest Null Fact Ref' = VAR maxFact = TOPN(1, Overview, DIVIDE(Overview[present_null_rows], Overview[rows_total]), DESC) RETURN "Nguồn: " & MAXX(maxFact, Overview[fact_name_vi])
		formatString: @
		lineageTag: b960bb17-14b9-435b-8901-22952e816b2b

	/// Màu chú thích cho Highest Null Fact Ref.
	measure 'Highest Null Fact Ref Color' = "#64748B"
		formatString: @
		lineageTag: cda5a106-abf1-4709-8fb3-9b5b7e1ea621

	/// Đỉnh sản lượng triệu tấn.
	measure 'Peak Production Hero' = IF(ISBLANK([Peak Production]), "Không áp dụng", FORMAT([Peak Production]/1000000, "#,0.00") & " tr tấn")
		formatString: @
		lineageTag: 84e73260-2e4c-4dd3-831b-dda2e662c33d

	/// Năm bắt đầu giai đoạn chọn.
	measure 'First Production Year Ref' = IF(ISBLANK([First Production Year]), "Không áp dụng", "Năm " & FORMAT([First Production Year], "0"))
		formatString: @
		lineageTag: b3eb6418-5cb1-4d12-b626-d8c1e298ee2a

	/// Màu chú thích cho First Production Year Ref.
	measure 'First Production Year Ref Color' = "#64748B"
		formatString: @
		lineageTag: 57a16bb2-1ee6-4058-aaae-fdaffaba9dab

	/// Tăng trưởng YoY kỳ cuối.
	measure 'Latest Production YoY Ref' = VAR v = [Latest Production YoY] RETURN IF(ISBLANK(v), "Không áp dụng", IF(v > 0, "▲ " & FORMAT(v, "0.00%") & " YoY", IF(v < 0, "▼ " & FORMAT(v, "0.00%") & " YoY", "• 0,00%" & " YoY")))
		formatString: @
		lineageTag: 1ebf3995-c0e7-4c31-98a8-ac7e2199934f

	/// Màu ngữ nghĩa cho Latest Production YoY Ref.
	measure 'Latest Production YoY Ref Color' = VAR v = [Latest Production YoY] RETURN IF(ISBLANK(v), "#64748B", IF(v > 0, "#16A34A", IF(v < 0, "#DC2626", "#64748B")))
		formatString: @
		lineageTag: 8b5339cb-b97c-439a-8f86-acda29d45081

	/// Mức tăng/giảm tuyệt đối đầu–cuối.
	measure 'Production Change Abs Ref' = IF(ISBLANK([Production Change]), "Không áp dụng", IF([Production Change] > 0, "▲ +" & FORMAT([Production Change]/1000000, "#,0.00") & " tr tấn", IF([Production Change] < 0, "▼ " & FORMAT([Production Change]/1000000, "#,0.00") & " tr tấn", "• 0,00 tr tấn")))
		formatString: @
		lineageTag: cba5adf9-22a7-4067-acb5-7c0b87542fe0

	/// Màu ngữ nghĩa cho Production Change Abs Ref.
	measure 'Production Change Abs Ref Color' = IF(ISBLANK([Production Change]), "#64748B", IF([Production Change] > 0, "#16A34A", IF([Production Change] < 0, "#DC2626", "#64748B")))
		formatString: @
		lineageTag: 22422677-ad98-453b-88b8-fe80f19c29fd

	/// Kỳ so sánh YoY mới nhất.
	measure 'Latest Production Period Ref' = IF(ISBLANK([Latest Production Year]), "Không áp dụng", IF([Latest Production YoY] >= 0, "▲ ", "▼ ") & FORMAT([Latest Production Year], "0") & " so " & FORMAT([Latest Production Year] - 1, "0"))
		formatString: @
		lineageTag: 66e8b2b0-ab32-4614-b67e-00ad2a5afe1e

	/// Năm đạt đỉnh sản lượng.
	measure 'Peak Year Ref' = IF(ISBLANK([Peak Year]), "Không áp dụng", "Kỷ lục năm " & FORMAT([Peak Year], "0"))
		formatString: @
		lineageTag: 00c260d6-0ad0-4b66-bbd9-76d827476809

	/// Màu chú thích cho Peak Year Ref.
	measure 'Peak Year Ref Color' = "#0F6B5E"
		formatString: @
		lineageTag: 1e4dd449-e783-41e7-9a82-9ca64562b572

	/// So sánh kỳ cuối với đỉnh.
	measure 'Latest vs Peak Ref' = IF(ISBLANK([Latest vs Peak Pct]), "Không áp dụng", IF([Latest vs Peak Pct] < 0, "▼ Dưới đỉnh " & FORMAT([Peak Year], "0"), "▲ Đạt đỉnh " & FORMAT([Peak Year], "0")))
		formatString: @
		lineageTag: debf0867-cb8c-4f8b-876e-acb913e7c199

	/// Màu ngữ nghĩa cho Latest vs Peak Ref.
	measure 'Latest vs Peak Ref Color' = IF(ISBLANK([Latest vs Peak Pct]), "#64748B", IF([Latest vs Peak Pct] < 0, "#DC2626", "#16A34A"))
		formatString: @
		lineageTag: 4f645bb7-1845-47e8-87d0-9a797512d945

	/// Khoảng thời gian diện tích.
	measure 'Area Span Ref' = IF(ISBLANK([Area Change Pct]), "Không áp dụng", IF([Area Change Pct] >= 0, "▲ ", "▼ ") & FORMAT([First Area Year], "0") & "–" & FORMAT([Latest Area Year], "0"))
		formatString: @
		lineageTag: 6a1c606d-e736-4b72-8ac6-c5054492f43f

	/// Màu ngữ nghĩa thay đổi diện tích.
	measure 'Area Span Ref Color' = IF(ISBLANK([Area Change Pct]), "#64748B", IF([Area Change Pct] >= 0, "#16A34A", "#DC2626"))
		formatString: @
		lineageTag: 2a53b1ae-7108-4afb-9736-de29584382e1

	/// Khoảng thời gian năng suất.
	measure 'Yield Span Ref' = IF(ISBLANK([Yield Change Pct]), "Không áp dụng", IF([Yield Change Pct] >= 0, "▲ ", "▼ ") & FORMAT([First Yield Year], "0") & "–" & FORMAT([Latest Yield Year], "0"))
		formatString: @
		lineageTag: a0a6acae-cb25-4491-b8e4-a2622a9e9d5e

	/// Màu ngữ nghĩa thay đổi năng suất.
	measure 'Yield Span Ref Color' = IF(ISBLANK([Yield Change Pct]), "#64748B", IF([Yield Change Pct] >= 0, "#16A34A", "#DC2626"))
		formatString: @
		lineageTag: d88d5aa5-3d83-4711-aeae-e61b173aef14

	/// Giá gạo Thái 5% mới nhất.
	measure 'Latest WB Thai 5 Hero' = FORMAT([Latest WB Thai 5 Price], "$#,0.00") & " /tấn"
		formatString: @
