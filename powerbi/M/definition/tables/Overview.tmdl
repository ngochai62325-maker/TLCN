	/// Biến động MoM gạo VN 5%.
	measure 'Latest WB VN 5 MoM Ref' = VAR v = [Latest WB VN 5 MoM] RETURN IF(ISBLANK(v), "Không áp dụng", IF(v > 0, "▲ " & FORMAT(v, "0.00%") & " MoM", IF(v < 0, "▼ " & FORMAT(v, "0.00%") & " MoM", "• 0,00%" & " MoM")))
		formatString: @
