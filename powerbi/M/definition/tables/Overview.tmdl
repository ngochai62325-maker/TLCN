	/// Giá gạo Việt Nam 5% mới nhất.
	measure 'Latest WB VN 5 Hero' = FORMAT([Latest WB VN 5 Price], "$#,0.00") & " /tấn"
		formatString: @
		lineageTag: 999d26fe-75c4-44bc-983b-f0b519f7d8c1

	/// Biến động MoM gạo Thái 5%.
	measure 'Latest WB Thai 5 MoM Ref' = VAR v = [Latest WB Thai 5 MoM] RETURN IF(ISBLANK(v), "Không áp dụng", IF(v > 0, "▲ " & FORMAT(v, "0.00%") & " MoM", IF(v < 0, "▼ " & FORMAT(v, "0.00%") & " MoM", "• 0,00%" & " MoM")))
		formatString: @
