table Overview
	lineageTag: 38345446-dcfe-497f-90f9-087963692068

	/// Tổng số quan sát toàn hệ thống Gold (tính từ fact_overview).
	measure 'Total Observations' = SUM(Overview[rows_total])
		formatString: #,0
		lineageTag: 0a54142b-50d9-4406-892b-bfae398cff18

	/// Số quan sát có dữ liệu số thực tế (tính từ fact_overview).
	measure 'Numeric Observations' = SUM(Overview[numeric_rows])
		formatString: #,0
		lineageTag: 91ad8328-d5c5-42e1-864e-000038ee6b71

	/// Số quan sát khuyết có ghi nhận (tính từ fact_overview).
	measure 'Present NULL' = SUM(Overview[present_null_rows])
		formatString: #,0
		lineageTag: af8ffc92-0d46-4a5e-9eda-b65da713f161

	/// Tỷ lệ quan sát có số trên tổng quan sát.
	measure 'Numeric Coverage' = DIVIDE([Numeric Observations], [Total Observations])
		formatString: 0.00%
		lineageTag: c439eacf-ce1d-4375-aef0-e69d4834464a

	/// V06.12 national annual quantity tonnes; one calendar year only; NULL remains blank; no SUM across years.
	measure 'Annual Production' = IF(HASONEVALUE(CalendarYear[Year]), SUM(NSOAnnual[production_t]))
		formatString: #,0
		lineageTag: 048d8b5a-3d34-4144-8935-a50950df93b1

	/// V06.12 national annual quantity hectares; one calendar year only; NULL remains blank; no SUM across years.
	measure 'Annual Area' = IF(HASONEVALUE(CalendarYear[Year]), SUM(NSOAnnual[area_ha]))
		formatString: #,0
		lineageTag: f43574a0-adf0-46dd-a19e-2847d6388ccc

	/// V06.14 national annual reported kg/ha; one calendar year only; NULL remains blank; no SUM across years.
	measure 'Reported Yield' = IF(HASONEVALUE(CalendarYear[Year]), SUM(NSOYield[yield_kg_ha]))
		formatString: #,0.00
		lineageTag: 3c97f216-def5-4748-bf48-f43c439212c6

	/// V06.12 source seasons, never includes annual; one calendar year only; NULL remains blank; no SUM across years.
	measure 'Seasonal Production' = IF(HASONEVALUE(CalendarYear[Year]), SUM(NSOSeasonal[production_t]))
		formatString: #,0
		lineageTag: be1dc368-d1ec-4c7d-829f-a13c5accd487

	/// CPC0113 selected non-overlapping source areas, tonnes; one calendar year only; NULL remains blank; no SUM across years.
	measure 'FAO Production' = IF(HASONEVALUE(CalendarYear[Year]), SUM(FAO[production_t]))
		formatString: #,0
		lineageTag: b40d8149-2298-42ae-9ae8-c61c7b06561d

	/// CPC0113 selected non-overlapping source areas, hectares; one calendar year only; NULL remains blank; no SUM across years.
	measure 'FAO Area' = IF(HASONEVALUE(CalendarYear[Year]), SUM(FAO[area_ha]))
		formatString: #,0
		lineageTag: c31e3a4d-a40f-49d7-aeca-a372d8a0d335

	/// First selected numeric V06.12 annual year.
	measure 'First Production Year' = MINX(FILTER(ALLSELECTED(CalendarYear[Year]), NOT ISBLANK(CALCULATE([Annual Production]))), CalendarYear[Year])
		formatString: 0
		lineageTag: b571a20d-04df-467a-b7fd-29d6eb87c6ee

	/// Latest selected numeric V06.12 annual year.
	measure 'Latest Production Year' = MAXX(FILTER(ALLSELECTED(CalendarYear[Year]), NOT ISBLANK(CALCULATE([Annual Production]))), CalendarYear[Year])
		formatString: 0
		lineageTag: 14ee26e4-d81a-4d81-86c1-d147908219e3

	/// First numeric selected annual production, V06.12 tonnes.
	measure 'First Production' = VAR y=[First Production Year] RETURN IF(NOT ISBLANK(y), CALCULATE([Annual Production], REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0
		lineageTag: c48a1074-1d53-4758-b8c8-0af8042a0120

	/// Latest numeric selected annual production, V06.12 tonnes.
	measure 'Latest Production' = VAR y=[Latest Production Year] RETURN IF(NOT ISBLANK(y), CALCULATE([Annual Production], REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0
		lineageTag: 59a9df2b-b05d-4b40-8717-f1c1788c3600

	/// Requires two distinct numeric comparable years; tonnes.
	measure 'Production Change' = IF([First Production Year]<[Latest Production Year], [Latest Production]-[First Production])
		formatString: +#,0;-#,0;0
		lineageTag: 0b34c0f6-1fb3-481d-87f2-fa2cfa66b5a1

	/// Endpoint ratio; positive first denominator; full selected scope recalculated.
	measure 'Production Change Pct' = IF([First Production]>0 && [First Production Year]<[Latest Production Year], DIVIDE([Production Change],[First Production]))
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 4dd8229a-116d-4b9d-88e0-aa7a1af31876

	/// Exact previous calendar year; never previous available row.
	measure 'Production YoY' = VAR y=SELECTEDVALUE(CalendarYear[Year]) VAR prev=CALCULATE([Annual Production],REMOVEFILTERS(CalendarYear),CalendarYear[Year]=y-1) VAR currentValue=[Annual Production] RETURN IF(NOT ISBLANK(y) && NOT ISBLANK(currentValue) && prev>0,DIVIDE(currentValue-prev,prev))
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 699f2911-c42d-4a53-838b-c5a6d0759ef8

	/// YoY at latest numeric selected year, exact prior year.
	measure 'Latest Production YoY' = VAR y=[Latest Production Year] RETURN IF(NOT ISBLANK(y),CALCULATE([Production YoY],REMOVEFILTERS(CalendarYear),CalendarYear[Year]=y))
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: b5a31716-c46c-4174-acde-14b69f340b78

	/// Observed numeric peak within selected V06.12 years, not a forecast.
	measure 'Peak Production' = MAXX(ALLSELECTED(CalendarYear[Year]),CALCULATE([Annual Production]))
		formatString: #,0
		lineageTag: 2a8d3666-0de0-427f-867e-b10a7becb440

	/// Earliest year if selected observed peaks tie.
	measure 'Peak Year' = VAR peak=[Peak Production] RETURN IF(NOT ISBLANK(peak), MINX(FILTER(ALLSELECTED(CalendarYear[Year]),CALCULATE([Annual Production])=peak),CalendarYear[Year]))
		formatString: 0
		lineageTag: b841925a-142e-45cc-b3fb-7fdf5ac5255b

	/// Selected endpoint vs selected observed peak.
	measure 'Latest vs Peak Pct' = IF([Peak Production]>0,DIVIDE([Latest Production]-[Peak Production],[Peak Production]))
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: ff0f7e0e-b1e1-46ab-a5a9-6ee2e6694c85

	/// Dynamic descriptive scope; all numeric facts come from current filters.
	measure 'NSO Insight' = IF(ISBLANK([First Production Year]),"Không có dữ liệu trong phạm vi chọn.",IF([First Production Year]=[Latest Production Year],"V06.12 · chỉ một năm có số: " & FORMAT([Latest Production Year],"0") & ". Thay đổi đầu–cuối: Không áp dụng. Yield V06.14 chỉ có từ 1995.","V06.12 · " & FORMAT([First Production Year],"0") & "–" & FORMAT([Latest Production Year],"0") & ": " & FORMAT([Production Change Pct],"+0.00%;-0.00%") & ". Đỉnh quan sát " & FORMAT([Peak Year],"0") & " (" & FORMAT([Peak Production]/1000000,"#,0.00") & " tr tấn); cuối kỳ so với đỉnh " & FORMAT([Latest vs Peak Pct],"+0.00%;-0.00%") & ". Diện tích: " & FORMAT([Area Change Pct],"+0.00%;-0.00%") & ", Năng suất: " & FORMAT([Yield Change Pct],"+0.00%;-0.00%") & ". Không suy quan hệ nhân quả."))
		formatString: @
		lineageTag: 6c747110-fec7-442c-9bce-5175241b3183

	/// Same eligible country/year population as paired area, tonnes.
	measure 'FAO Paired Production' = IF(HASONEVALUE(CalendarYear[Year]),SUM(FAO[paired_production_t]))
		formatString: #,0
		lineageTag: a37db928-e097-4a07-b076-1bdb2d55e406

	/// Only pairs with numeric production and positive numeric area, hectares.
	measure 'FAO Paired Area' = IF(HASONEVALUE(CalendarYear[Year]),SUM(FAO[paired_area_ha]))
		formatString: #,0
		lineageTag: 5e2231a3-79b8-4f75-a56f-6dbeba1f7f75

	/// kg/ha, single calendar year, ratio of paired sums over selected non-overlapping area universe; never AVG yields.
	measure 'FAO Weighted Yield' = DIVIDE(1000*[FAO Paired Production],[FAO Paired Area])
		formatString: #,0.00
		lineageTag: 6154512f-7e69-4f95-8ecb-282cfb394108

	/// Source reported kg/ha, one source area/year; not combined across areas.
	measure 'FAO Reported Yield' = IF(HASONEVALUE(CalendarYear[Year]) && HASONEVALUE(FAO[geography_key]),MAX(FAO[reported_yield_kg_ha]))
		formatString: #,0.00
		lineageTag: fa634d03-a430-42c5-9e24-fb02340723c7

	/// Latest selected year with valid paired measures for every selected area; selected universe only.
	measure 'FAO Common Year' = MAXX(FILTER(ALLSELECTED(CalendarYear[Year]), VAR n=CALCULATE(DISTINCTCOUNT(FAO[geography_key]),ALLSELECTED(FAO[area_name]),FAO[paired_valid]=TRUE()) VAR expected=CALCULATE(DISTINCTCOUNT(FAO[geography_key]),ALLSELECTED(FAO[area_name]),REMOVEFILTERS(CalendarYear)) RETURN n=expected && n>0),CalendarYear[Year])
		formatString: 0
		lineageTag: e72b9aea-6d38-460a-9d1a-3cd7aff440fc

	/// Production at selected common year, not world total.
	measure 'FAO Common Production' = VAR y=[FAO Common Year] RETURN IF(NOT ISBLANK(y), CALCULATE([FAO Production],REMOVEFILTERS(CalendarYear),CalendarYear[Year]=y))
		formatString: #,0
		lineageTag: 33fa55b6-a285-4067-af8d-706973de59d7

	/// Rank only among admitted selected source areas, common paired year.
	measure 'FAO Common Rank' = IF(NOT ISBLANK([FAO Common Production]),RANKX(ALLSELECTED(FAO[area_name]),[FAO Common Production],,DESC,Dense))
		formatString: 0
		lineageTag: 5b2777a0-7235-424e-bdea-146ce7cf2536

	/// Active year for FAO scatter: selected single year, or common paired year when all years are selected.
	measure 'FAO Scatter Year' = IF(HASONEVALUE(CalendarYear[Year]), SELECTEDVALUE(CalendarYear[Year]), [FAO Common Year])
		formatString: 0
		lineageTag: ad94a5d9-1bb7-4e49-abce-ce79c57fbb75

	/// Area at selected year or default common year.
	measure 'FAO Scatter Area' = VAR y=[FAO Scatter Year] RETURN IF(NOT ISBLANK(y), CALCULATE(SUM(FAO[area_ha]), REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0
		lineageTag: bebbc913-8681-4e9c-8009-61b25e4434ad

	/// Production at selected year or default common year.
	measure 'FAO Scatter Production' = VAR y=[FAO Scatter Year] RETURN IF(NOT ISBLANK(y), CALCULATE(SUM(FAO[production_t]), REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0
		lineageTag: 39f5ccd6-6e8f-43d2-ab10-0e4ff2ed9ad6

	/// Weighted yield at selected year or default common year.
	measure 'FAO Scatter Yield' = VAR y=[FAO Scatter Year] RETURN IF(NOT ISBLANK(y), CALCULATE([FAO Weighted Yield], REMOVEFILTERS(CalendarYear), CalendarYear[Year]=y))
		formatString: #,0.00
		lineageTag: 95b5016e-baaa-4bee-87d5-485ddc8f5ae8

	/// One SUA calendar year/element, M49 704/CPC23161.02; NULL stays blank; no cross-element SUM.
	measure 'SUA Selected Value' = IF(HASONEVALUE(CalendarYear[Year]) && HASONEVALUE(SUA[element_code]),MAX(SUA[value_t]))
		formatString: #,0.00
		lineageTag: 1b755786-f526-4fcd-b2c3-f22a876b851f

	/// SUA element 5141; one calendar year, tonnes; no sum over years or invented balance.
	measure 'SUA Food Supply' = CALCULATE([SUA Selected Value],REMOVEFILTERS(SUA[element_code]),REMOVEFILTERS(SUA[metric]),SUA[element_code]="5141")
		formatString: #,0.00
		lineageTag: 306143a5-f1c1-48c1-8508-3706773b798f

	/// SUA element 5113; one calendar year, tonnes; no sum over years or invented balance.
	measure 'SUA Opening Stocks' = CALCULATE([SUA Selected Value],REMOVEFILTERS(SUA[element_code]),REMOVEFILTERS(SUA[metric]),SUA[element_code]="5113")
		formatString: #,0.00
		lineageTag: 8450a21a-d38a-4d9f-9f70-bc864de39e3c

	/// SUA element 5071; one calendar year, tonnes; no sum over years or invented balance.
	measure 'SUA Stock Variation' = CALCULATE([SUA Selected Value],REMOVEFILTERS(SUA[element_code]),REMOVEFILTERS(SUA[metric]),SUA[element_code]="5071")
		formatString: #,0.00
		lineageTag: b123f0a2-0f3e-4a2e-9294-3fd3acebf239

	/// SUA element 5023; one calendar year, tonnes; no sum over years or invented balance.
	measure 'SUA Processed' = CALCULATE([SUA Selected Value],REMOVEFILTERS(SUA[element_code]),REMOVEFILTERS(SUA[metric]),SUA[element_code]="5023")
		formatString: #,0.00
		lineageTag: 3810a006-2a5e-42e7-8885-e8efa147fa73

	/// SUA element 5520; one calendar year, tonnes; no sum over years or invented balance.
	measure 'SUA Feed' = CALCULATE([SUA Selected Value],REMOVEFILTERS(SUA[element_code]),REMOVEFILTERS(SUA[metric]),SUA[element_code]="5520")
		formatString: #,0.00
		lineageTag: 5a0488ff-d794-488f-a543-9871f2d7468c

	/// SUA element 5525; one calendar year, tonnes; no sum over years or invented balance.
	measure 'SUA Seed' = CALCULATE([SUA Selected Value],REMOVEFILTERS(SUA[element_code]),REMOVEFILTERS(SUA[metric]),SUA[element_code]="5525")
		formatString: #,0.00
		lineageTag: 2765ffaa-5162-40e4-b122-47cdbe25457f

	/// SUA element 5016; one calendar year, tonnes; no sum over years or invented balance.
	measure 'SUA Loss' = CALCULATE([SUA Selected Value],REMOVEFILTERS(SUA[element_code]),REMOVEFILTERS(SUA[metric]),SUA[element_code]="5016")
		formatString: #,0.00
		lineageTag: 465fa88e-fcd3-4438-9adc-288aa5ea71b4

	/// SUA element 5910; one calendar year, tonnes; no sum over years or invented balance.
	measure 'SUA Exports' = CALCULATE([SUA Selected Value],REMOVEFILTERS(SUA[element_code]),REMOVEFILTERS(SUA[metric]),SUA[element_code]="5910")
		formatString: #,0.00
		lineageTag: 765c85d9-d16f-4787-9550-8bbcfe787100

	/// SUA element 5165; one calendar year, tonnes; no sum over years or invented balance.
	measure 'SUA Other Uses' = CALCULATE([SUA Selected Value],REMOVEFILTERS(SUA[element_code]),REMOVEFILTERS(SUA[metric]),SUA[element_code]="5165")
		formatString: #,0.00
		lineageTag: 793fe6c3-2f60-4feb-964c-35a134c71aba

	/// SUA element 5166; one calendar year, tonnes; no sum over years or invented balance.
	measure 'SUA Residuals' = CALCULATE([SUA Selected Value],REMOVEFILTERS(SUA[element_code]),REMOVEFILTERS(SUA[metric]),SUA[element_code]="5166")
		formatString: #,0.00
		lineageTag: 51ec7e72-7fbc-4fad-93f8-091eb51cf4bb

	/// One marketing year and attribute; unit from row. No mixing MY/TY/rough/milled, rates or stocks.
	measure 'PSD Selected Value' = IF(HASONEVALUE(PSD[market_year]) && HASONEVALUE(PSD[attribute]),MAX(PSD[value]))
		formatString: #,0.00
		lineageTag: 69103661-a334-491a-9e25-4c5e57fda510

	/// USDA Vietnam/Rice, Milled Production tonnes at one market year; no stock sum across time.
	measure 'PSD Production' = CALCULATE([PSD Selected Value],REMOVEFILTERS(PSD[attribute]),PSD[attribute]="Production")
		formatString: #,0
		lineageTag: c2c27db6-e24d-42de-bdda-2b0725364570

	/// USDA Vietnam/Rice, Milled Domestic Consumption tonnes at one market year; no stock sum across time.
	measure 'PSD Consumption' = CALCULATE([PSD Selected Value],REMOVEFILTERS(PSD[attribute]),PSD[attribute]="Domestic Consumption")
		formatString: #,0
		lineageTag: 0c59fb91-abf4-4353-87d5-f3564685458a

	/// USDA Vietnam/Rice, Milled Ending Stocks tonnes at one market year; no stock sum across time.
	measure 'PSD Ending Stocks' = CALCULATE([PSD Selected Value],REMOVEFILTERS(PSD[attribute]),PSD[attribute]="Ending Stocks")
		formatString: #,0
		lineageTag: d621ecad-a436-4da9-bfa8-fa7d31e34333

	/// USDA FOB export price reference USD/tonne; guardrail: yêu cầu chọn đúng 1 quốc gia và 1 phẩm cấp.
	measure 'USDA Price' = IF(HASONEVALUE(USDAPrice[location]) && HASONEVALUE(USDAPrice[commodity_class]), IF(HASONEVALUE(USDAPrice[reference_year]), AVERAGE(USDAPrice[price_usd_t]), AVERAGE(USDAPrice[price_usd_t])))
		formatString: #,0.00
		lineageTag: eae7a999-efbc-4ea2-ae43-139635acc53b

	/// World Bank benchmark monthly USD/tonne level; guardrail: yêu cầu đúng 1 chuỗi giá và 1 tháng.
	measure 'WB Price' = IF(HASONEVALUE(WB[series_code]) && HASONEVALUE(BenchmarkMonth[Date]), MAX(WB[price_usd_t]))
		formatString: #,0.00
		lineageTag: 05868a94-f39b-4546-b4a0-c36f11751aee

	/// Exact calendar previous month for single selected WB series; guardrail cấm trộn chuỗi.
	measure 'WB MoM' = IF(HASONEVALUE(WB[series_code]) && HASONEVALUE(BenchmarkMonth[Date]), MAX(WB[monthly_change_pct])/100)
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: a151e937-7992-4d94-a301-6a07a2f2804c

	/// Trailing 12 log-return sample std for single selected WB series; guardrail cấm trộn chuỗi.
	measure 'WB Volatility' = IF(HASONEVALUE(WB[series_code]) && HASONEVALUE(BenchmarkMonth[Date]), MAX(WB[volatility_12m_pct])/100)
		formatString: 0.00%
		lineageTag: e2954b8f-b115-4ba1-bcba-2d941f6b9d09

	/// Observed maximum benchmark in selected months, USD/tonne.
	measure 'WB Peak' = MAXX(ALLSELECTED(BenchmarkMonth[Date]),CALCULATE([WB Price]))
		formatString: #,0.00
		lineageTag: de09c705-61d8-475f-8037-a3bf3c81b62b

	/// Observed numeric minimum selected monthly benchmark, USD/tonne.
	measure 'WB Minimum' = MINX(FILTER(ALLSELECTED(BenchmarkMonth[Date]),NOT ISBLANK(CALCULATE([WB Price]))),CALCULATE([WB Price]))
		formatString: #,0.00
		lineageTag: 5250189a-3c39-4415-a305-4cd95eaa6d16

	/// Numeric monthly prices in selected calendar; no imputation.
	measure 'WB Numeric Months' = COALESCE(CALCULATE(COUNTROWS(WB),WB[numeric_present]=TRUE()),0)
		formatString: #,0
		lineageTag: f53b6563-eeea-4295-8f0c-fcb82f419108

	/// Count of calendar rows with no source observation.
	measure 'WB Absent Months' = COALESCE(CALCULATE(COUNTROWS(WB),WB[observation_present]=FALSE()),0)
		formatString: #,0
		lineageTag: df5a8c85-9ef3-4c91-980b-db0e1c38edab

	/// Vietnam domestic quote VND/kg; guardrail: yêu cầu chọn đúng 1 giống lúa và 1 loại giá xác định.
	measure 'Domestic Quote' = IF(HASONEVALUE(VNQuote[commodity]) && HASONEVALUE(VNQuote[price_type]), IF(HASONEVALUE(QuoteDate[Date]), MAX(VNQuote[price_vnd_kg]), AVERAGE(VNQuote[price_vnd_kg])))
		formatString: #,0
		lineageTag: 6bb70ecf-0a9f-4797-a826-63bf39795c41

	/// Số ngày có báo giá duy nhất trong phạm vi chọn.
	measure 'Domestic Quoted Dates' = DISTINCTCOUNT(VNQuote[date])
		formatString: #,0
		lineageTag: 034da08b-a725-4afd-9f2e-3f354ca420f1

	/// Reported export tonnes; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Quantity' = SUM(Trade[quantity_t])
		formatString: #,0.00
		lineageTag: 7a955ed2-5cb6-41d4-92ff-b564c7cbc619

	/// Reported export USD; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Value' = SUM(Trade[value_usd])
		formatString: #,0.00
		lineageTag: c8b0970a-f315-4a0c-b4fb-f2e3f420c6d9

	/// Numeric quantity paired with numeric monetary value and q>0; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Paired Quantity' = SUM(Trade[paired_quantity_t])
		formatString: #,0.00
		lineageTag: 67a359b6-b7c2-468e-b307-517b133efaa1

	/// Same eligible contributor population as paired quantity; reporter704/CPC23161.02/export/2019–2023. Additive over disjoint selected partner-year groups; blanks retained.
	measure 'Trade Paired Value' = SUM(Trade[paired_value_usd])
		formatString: #,0.00
		lineageTag: fd35d441-9ad1-4ebf-9c1f-ff99e136b9cb

	/// USD/tonne = ratio of paired sums under current year/partner selection; never average row ratios; positive paired denominator.
	measure 'Trade Unit Value' = DIVIDE([Trade Paired Value],[Trade Paired Quantity])
		formatString: #,0.00
		lineageTag: 27755026-fb0d-41e9-b0e5-9776d43e18ee

	/// Eligible paired reporter-partner-product-year groups; coverage of selected partner scope (35 cặp).
	measure 'Trade Paired Groups' = COALESCE(COUNTROWS(FILTER(Trade, NOT ISBLANK(Trade[paired_quantity_t]) && NOT ISBLANK(Trade[paired_value_usd]))), 0)
		formatString: #,0
		lineageTag: c7e11e95-29e3-4d74-8c5a-9d0e11dd27ce

	/// Dynamic paired coverage and ratio; no global denominator.
	measure 'Trade Insight' = IF([Trade Paired Groups]=0,"Không có cặp đủ điều kiện trong phạm vi chọn.","Việt Nam → " & CONCATENATEX(VALUES(Trade[partner_name_vi]),Trade[partner_name_vi],", ") & " · " & FORMAT(MIN(Trade[year]),"0") & "–" & FORMAT(MAX(Trade[year]),"0") & " · CPC23161.02. " & FORMAT([Trade Partners],"0") & " đối tác (" & FORMAT([Trade Paired Groups],"0") & " cặp năm–đối tác); đơn giá bình quân " & FORMAT([Trade Unit Value],"#,0.00") & " USD/t. Tỷ số giá trị/lượng báo cáo; không phải giá thị trường độc lập.")
		formatString: @
		lineageTag: 2f3ee4cc-e2e5-4918-b99e-acfb025f3863

	/// Tổng quan sát format vi-VN.
	measure 'Total Observations Display' = FORMAT([Total Observations], "#,0")
		formatString: @
		lineageTag: a3d65fd1-2ed8-4822-a87d-53cacc257321

	/// Tỷ lệ có số format vi-VN.
	measure 'Numeric Coverage Display' = FORMAT([Numeric Coverage], "0.00%")
		formatString: @
