		lineageTag: 92002c36-b626-4188-b018-5fc2f3207711

	/// Chênh lệch giá World Bank: Việt Nam 5% − Thái 5% (USD/tấn).
	measure 'WB Spread VN5 vs Thai5' = VAR m = [Latest Common WB Month] VAR vn = CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_viet_namese_5", WB[month_date] = m) VAR thai = CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(WB), WB[series_code] = "rice_thai_5", WB[month_date] = m) RETURN IF(NOT ISBLANK(vn) && NOT ISBLANK(thai), vn - thai)
		formatString: #,0.00
		lineageTag: 8956f10b-c141-43fd-9a83-2544446e5707

	/// Thẻ chênh lệch giá VN 5% − Thái 5%.
	measure 'WB Spread VN5 vs Thai5 Display' = IF(ISBLANK([WB Spread VN5 vs Thai5]), "Không áp dụng", FORMAT([WB Spread VN5 vs Thai5], "+$#,0.00;-$#,0.00;$0.00") & " /tấn")
		formatString: @
		lineageTag: d11bee71-5eed-4828-af28-e889b39fbb6f

	/// Biến động MoM: 2 chuỗi 5% đối sánh mặc định, hoặc chuỗi được chọn.
	measure 'WB MoM Comparison' = IF(HASONEVALUE(WB[series_code]), [WB MoM], IF(SELECTEDVALUE(WB[series_code]) IN {"rice_thai_5", "rice_viet_namese_5"}, [WB MoM]))
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 05ace4b7-3601-455c-851e-ada7c92abc3b

	/// Độ biến động 12M: 2 chuỗi 5% đối sánh mặc định, hoặc chuỗi được chọn.
	measure 'WB Volatility Comparison' = IF(HASONEVALUE(WB[series_code]), [WB Volatility], IF(SELECTEDVALUE(WB[series_code]) IN {"rice_thai_5", "rice_viet_namese_5"}, [WB Volatility]))
		formatString: 0.00%
		lineageTag: bfed9473-2a35-4c5d-83ce-8f96583b1327

	/// Tiêu đề động biểu đồ MoM.
	measure 'WB MoM Title' = IF(HASONEVALUE(WB[series_code]), "[Gạo xay xát] Biến động MoM – " & SELECTEDVALUE(WB[series_name_vi]) & " (%)", "[Gạo xay xát] Biến động MoM – Gạo Thái 5% & VN 5% (%)")
		formatString: @
		lineageTag: 6c8b91e2-1967-4ba7-9dca-1459b67c1a1f

	/// Giá nội địa chuỗi chuẩn (Lúa IR 50404 tươi · Thương lái thu mua); trả BLANK() khi không có quan sát hợp lệ.
	measure 'Domestic Quote Chart Price' = VAR chosen_series = "Lúa IR 50404 (lúa tươi) · Thương lái thu mua" VAR valid_rows = FILTER(VNQuote, VNQuote[series_label] = chosen_series && NOT ISBLANK(VNQuote[price_vnd_kg]) && VNQuote[price_vnd_kg] > 0) RETURN IF(COUNTROWS(valid_rows) > 0, AVERAGEX(valid_rows, VNQuote[price_vnd_kg]), BLANK())
		formatString: #,0
		lineageTag: 79e5f0f3-4b5e-4ad7-b379-7a9fd9937bd1

	/// Tiêu đề động biểu đồ giá nội địa liệt kê đúng tập thị trường hiển thị.
	measure 'Domestic Quote Chart Title' = VAR chosen_series = "Lúa IR 50404 (lúa tươi) · Thương lái thu mua" VAR valid_markets = FILTER(VALUES(VNQuote[market]), CALCULATE(COUNTROWS(VNQuote), VNQuote[series_label] = chosen_series, NOT ISBLANK(VNQuote[price_vnd_kg]), VNQuote[price_vnd_kg] > 0) > 0) VAR market_list = CONCATENATEX(valid_markets, VNQuote[market], ", ", VNQuote[market], ASC) RETURN IF(ISBLANK(market_list) || market_list = "", "[Lúa] Giá nội địa – " & chosen_series & " (không có dữ liệu)", "[Lúa] Giá nội địa (" & market_list & ") – " & chosen_series & " (VND/kg)")
		formatString: @
		lineageTag: 7950e260-2fdd-4a86-8f61-b84109a427d4

