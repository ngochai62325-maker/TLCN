	/// Mức giá World Bank tại tháng mới nhất của chuỗi đang chọn.
	measure 'Latest WB Price' = VAR m=[Latest WB Month] RETURN IF(NOT ISBLANK(m) && HASONEVALUE(WB[series_code]), CALCULATE(MAX(WB[price_usd_t]), REMOVEFILTERS(BenchmarkMonth), BenchmarkMonth[Date]=m))
		formatString: #,0.00
		lineageTag: 54c20831-269c-47d8-a6ec-a182782e7380

	/// Thay đổi MoM tại tháng mới nhất của chuỗi đang chọn.
	measure 'Latest WB MoM' = VAR m=[Latest WB Month] RETURN IF(NOT ISBLANK(m) && HASONEVALUE(WB[series_code]), CALCULATE(MAX(WB[monthly_change_pct])/100, REMOVEFILTERS(BenchmarkMonth), BenchmarkMonth[Date]=m))
		formatString: +0.00%;-0.00%;0.00%
