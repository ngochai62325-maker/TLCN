		lineageTag: c91c048d-70df-4b78-aa41-eadcb6d4910f
		summarizeBy: none
		sourceColumn: price_usd_t

	column observation_present
		dataType: boolean
		lineageTag: 4d5665d1-ab1f-4905-a2f0-8d5d5a196d6f
