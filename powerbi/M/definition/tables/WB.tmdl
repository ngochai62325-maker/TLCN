table WB
	lineageTag: 9b7b162d-6bbf-406c-a436-383636b42136

	column month_date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 2d30dccd-740e-4d53-8638-2180718ff6e0
		summarizeBy: none
