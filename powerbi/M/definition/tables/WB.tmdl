	column series_key
		dataType: string
		lineageTag: 94132a91-ed44-40ce-b6ee-19745e4e56ee
		summarizeBy: none
		sourceColumn: series_key

	column series_code
		dataType: string
		lineageTag: 17b355c2-7462-4fe2-9bf8-d6848d39e639
		summarizeBy: none
		sourceColumn: series_code

	column unit
