table WB
	lineageTag: 46027c57-d4b2-49ac-863a-a25018546315

	column month_date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 481c2b80-fed3-4e9a-93fc-d9d6bf1bc178
		summarizeBy: none
		sourceColumn: month_date

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		lineageTag: ad6b3f48-8915-419d-9cd5-a9a0f5c8eaa7
		summarizeBy: none
		sourceColumn: year

	column month_key
		dataType: int64
