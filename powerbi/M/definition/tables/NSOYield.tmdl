table NSOYield
	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year
	column yield_kg_ha
		dataType: double
		summarizeBy: none
		sourceColumn: yield_kg_ha
	column publication
		dataType: string
		summarizeBy: none
		sourceColumn: publication
	column yield_present
		dataType: boolean
		summarizeBy: none
		sourceColumn: yield_present
	partition NSOYield = m
		mode: import
		source =
			let
			    Raw = Csv.Document(File.Contents(ExportFolder & "\nso_reported_yield.csv"), [Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
			    Checked = if Table.ColumnNames(Headers) = {"year", "yield_kg_ha", "publication", "yield_present"} then Headers else error "CSV schema mismatch",
			    Missing = Table.ReplaceValue(Checked, "", null, Replacer.ReplaceValue, Table.ColumnNames(Checked)),
			    Typed = Table.TransformColumnTypes(Missing, {{"year", Int64.Type}, {"yield_kg_ha", type number}, {"publication", type text}, {"yield_present", type logical}}, "en-US"),
			    Manifest = Json.Document(File.Contents(ExportFolder & "\export_manifest.json")),
			    Entry = Record.Field(Manifest[outputs], "nso_reported_yield.csv"),
			    Accepted = if Manifest[status] = "COMPLETE" and Manifest[format_version] = "powerbi-csv-2" and Table.RowCount(Typed) = Entry[rows] then Typed else error "Verify the immutable mart bundle before refresh"
			in
			    Accepted
