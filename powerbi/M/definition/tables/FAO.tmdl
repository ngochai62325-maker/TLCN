	partition FAO = m
		mode: import
		source =
				let
				    Raw = Csv.Document(File.Contents(ExportFolder & "\fao_production.csv"), [Delimiter=",", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
				    Checked = if Table.ColumnNames(Headers) = {"year", "geography_key", "area_code", "area_name", "product_key", "product_code", "production_t", "area_ha", "reported_yield_kg_ha", "computed_yield_kg_ha", "production_present", "area_present", "yield_present", "paired_valid", "paired_production_t", "paired_area_ha"} then Headers else error "CSV schema mismatch",
				    Missing = Table.ReplaceValue(Checked, "", null, Replacer.ReplaceValue, Table.ColumnNames(Checked)),
				    Typed = Table.TransformColumnTypes(Missing, {{"year", Int64.Type}, {"geography_key", type text}, {"area_code", type text}, {"area_name", type text}, {"product_key", type text}, {"product_code", type text}, {"production_t", type number}, {"area_ha", type number}, {"reported_yield_kg_ha", type number}, {"computed_yield_kg_ha", type number}, {"production_present", type logical}, {"area_present", type logical}, {"yield_present", type logical}, {"paired_valid", type logical}, {"paired_production_t", type number}, {"paired_area_ha", type number}}, "en-US"),
				    Manifest = Json.Document(File.Contents(ExportFolder & "\export_manifest.json")),
				    Entry = Record.Field(Manifest[outputs], "fao_production.csv"),
				    Accepted = if Manifest[status] = "COMPLETE" and Manifest[format_version] = "powerbi-csv-2" and Table.RowCount(Typed) = Entry[rows] then Typed else error "Verify the immutable mart bundle before refresh",
				    With_area_name_vi = Table.AddColumn(Accepted, "area_name_vi", each if [area_name] = "India" then "Ấn Độ" else if [area_name] = "Indonesia" then "Indonesia" else if [area_name] = "Pakistan" then "Pakistan" else if [area_name] = "Thailand" then "Thái Lan" else if [area_name] = "Viet Nam" then "Việt Nam" else [area_name], type text)
				in
				    With_area_name_vi

	annotation PBI_ResultType = Table

