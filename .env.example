# Copy to .env to customize local credentials and ports. Keep personal API keys out of Git.
# Raw dataset root relative to the repository (21 pinned files + nso/metadata.txt).
SILVER_TEST_RAW_ROOT=./data/raw

# Local Docker image tags
TLCN_SPARK_IMAGE=tlcn/silver-spark:local
TLCN_AIRFLOW_IMAGE=tlcn/silver-airflow:local

# Airflow UI (http://localhost:8085)
AIRFLOW_PORT=8085
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Local
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.local

# MinIO Console (http://localhost:9001) & S3 credentials
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Trino Coordinator HTTP (http://localhost:18080)
TRINO_HOST_PORT=18080

# PostgreSQL metadata store (internal-only)
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse123
POSTGRES_DB=lakehouse_meta

# Optional external API keys ( preserved in .env )
USDA_API_KEY=your_key
FAOSTAT_API_TOKEN=your_token